<node id="Menteri yang Membidangi Urusan Pelayaran">
  <data key="d0">pihak</data>
  <data key="d1">Pejabat yang berwenang mengangkat syahbandar di pelabuhan perikanan. Pejabat yang mengangkat syahbandar di pelabuhan perikanan.</data>
