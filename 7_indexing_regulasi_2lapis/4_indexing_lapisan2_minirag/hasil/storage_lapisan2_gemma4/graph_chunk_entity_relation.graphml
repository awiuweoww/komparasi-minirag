  <data key="d2">chunk-0005</data>
</node>
<node id="Jenis, Jumlah, dan Ukuran Alat Penangkapan Ikan">
  <data key="d0">konsep</data>
  <data key="d1">Spesifikasi alat penangkapan ikan yang ditetapkan Menteri. Data mengenai jenis, jumlah, dan ukuran alat penangkapan ikan.</data>
  <data key="d2">chunk-0005</data>
</node>
<node id="Jenis, Jumlah, Ukuran, dan Penempatan Alat Bantu Penangkapan Ikan">
  <data key="d0">konsep</data>
