</node>
<node id="Pasal 73A UU Perikanan versi UU Nomor 45 Tahun 2009">
  <data key="d0">struktur</data>
  <data key="d1">Rumusan Pasal 73A dalam UU Nomor 45 Tahun 2009: kewenangan Penyidik dalam penyidikan tindak pidana perikanan.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Hak Menerima Laporan atau Pengaduan">
  <data key="d0">hak</data>
  <data key="d1">Kewenangan Penyidik untuk menerima laporan atau pengaduan dari seseorang tentang adanya tindak pidana di bidang perikanan.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Hak Memanggil dan Memeriksa Tersangka dan/atau Saksi">
  <data key="d0">hak</data>
  <data key="d1">Kewenangan Penyidik untuk memanggil dan memeriksa tersangka dan/atau saksi untuk didengar keterangannya.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Hak Membawa dan Menghadapkan Seseorang">
  <data key="d0">hak</data>
  <data key="d1">Kewenangan Penyidik untuk membawa dan menghadapkan seseorang sebagai tersangka dan/atau saksi untuk didengar keterangannya.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Hak Menggeledah Sarana dan Prasarana Perikanan">
  <data key="d0">hak</data>
  <data key="d1">Kewenangan Penyidik untuk menggeledah sarana dan prasarana perikanan yang diduga digunakan dalam atau menjadi tempat melakukan tindak pidana di bidang perikanan.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Hak Menghentikan, Memeriksa, Menangkap, Membawa, dan/atau Menahan Kapal dan/atau Orang">
  <data key="d0">hak</data>
  <data key="d1">Kewenangan Penyidik untuk menghentikan, memeriksa, menangkap, membawa, dan/atau menahan kapal dan/atau orang yang disangka melakukan tindak pidana di bidang perikanan.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Hak Memeriksa Kelengkapan dan Keabsahan Dokumen Usaha Perikanan">
  <data key="d0">hak</data>
  <data key="d1">Kewenangan Penyidik untuk memeriksa kelengkapan dan keabsahan dokumen usaha perikanan.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Hak Memotret Tersangka dan/atau Barang Bukti">
  <data key="d0">hak</data>
  <data key="d1">Kewenangan Penyidik untuk memotret tersangka dan/atau barang bukti tindak pidana di bidang perikanan.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Hak Mendatangkan Ahli">
  <data key="d0">hak</data>
  <data key="d1">Kewenangan Penyidik untuk mendatangkan ahli yang diperlukan dalam hubungannya dengan tindak pidana di bidang perikanan.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Hak Membuat dan Menandatangani Berita Acara Pemeriksaan">
  <data key="d0">hak</data>
  <data key="d1">Kewenangan Penyidik untuk membuat dan menandatangani berita acara pemeriksaan.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Hak Melakukan Penyitaan terhadap Barang Bukti">
  <data key="d0">hak</data>
  <data key="d1">Kewenangan Penyidik untuk melakukan penyitaan terhadap barang bukti yang digunakan dan/atau hasil tindak pidana.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Hak Melakukan Penghentian Penyidikan">
  <data key="d0">hak</data>
  <data key="d1">Kewenangan Penyidik untuk melakukan penghentian penyidikan.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Hak Mengadakan Tindakan Lain yang Dapat Dipertanggungjawabkan">
  <data key="d0">hak</data>
  <data key="d1">Kewenangan Penyidik untuk mengadakan tindakan lain yang menurut hukum dapat dipertanggungjawabkan.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Tindak Pidana di Bidang Perikanan">
  <data key="d0">konsep</data>
  <data key="d1">Tindak pidana yang terjadi di bidang perikanan sebagai objek penyidikan. Kejahatan atau pelanggaran hukum di bidang perikanan. Pelanggaran hukum di bidang perikanan.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Sarana dan Prasarana Perikanan">
  <data key="d0">konsep</data>
  <data key="d1">Sarana dan prasarana yang digunakan dalam atau menjadi tempat melakukan tindak pidana di bidang perikanan.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Berita Acara Pemeriksaan">
  <data key="d0">konsep</data>
  <data key="d1">Dokumen hasil pemeriksaan yang dibuat dan ditandatangani oleh Penyidik.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Barang Bukti">
  <data key="d0">konsep</data>
  <data key="d1">Benda atau hasil yang digunakan atau dihasilkan dari tindak pidana.</data>
  <data key="d2">chunk-0026</data>
</node>
<node id="Pasal 73B ayat (1) UU Perikanan versi UU Nomor 45 Tahun 2009">
  <data key="d0">struktur</data>
  <data key="d1">Rumusan Pasal 73B ayat (1) menurut UU Nomor 45 Tahun 2009: kewajiban penyidik memberitahukan dimulainya penyidikan.</data>
  <data key="d2">chunk-0027</data>
</node>
<node id="Kewajiban Memberitahukan Dimulainya Penyidikan bagi Penyidik">
  <data key="d0">kewajiban</data>
  <data key="d1">Penyidik wajib memberitahukan dimulainya penyidikan kepada penuntut umum paling lama 7 hari sejak ditemukan tindak pidana.</data>
  <data key="d2">chunk-0027</data>
</node>
<node id="Penuntut Umum">
  <data key="d0">pihak</data>
  <data key="d1">Pejabat yang menerima pemberitahuan dimulainya penyidikan. Pejabat yang melakukan penuntutan perkara tindak pidana di bidang perikanan. Pihak yang menerima berkas penyidikan dan melimpahkan perkara ke pengadilan.</data>
  <data key="d2">chunk-0027</data>
</node>
<node id="Pasal 73B ayat (2) UU Perikanan versi UU Nomor 45 Tahun 2009">
  <data key="d0">struktur</data>
  <data key="d1">Rumusan Pasal 73B ayat (2) menurut UU Nomor 45 Tahun 2009: kewenangan penyidik menahan tersangka.</data>
  <data key="d2">chunk-0027</data>
</node>
<node id="Hak Menahan Tersangka bagi Penyidik">
  <data key="d0">hak</data>
  <data key="d1">Penyidik dapat menahan tersangka paling lama 20 hari untuk kepentingan penyidikan.</data>
  <data key="d2">chunk-0027</data>
</node>
<node id="Tersangka">
  <data key="d0">pihak</data>
  <data key="d1">Orang yang diduga melakukan tindak pidana dan sedang dalam proses penyidikan. Orang yang diduga melakukan tindak pidana dan dapat ditahan. Orang yang ditetapkan sebagai tersangka dalam tindak pidana perikanan atau lainnya.</data>
  <data key="d2">chunk-0027</data>
</node>
<node id="Pasal 73B ayat (3) UU Perikanan versi UU Nomor 45 Tahun 2009">
  <data key="d0">struktur</data>
  <data key="d1">Rumusan Pasal 73B ayat (3) menurut UU Nomor 45 Tahun 2009: kewenangan penuntut umum memperpanjang penahanan.</data>
  <data key="d2">chunk-0027</data>
</node>
<node id="Hak Memperpanjang Penahanan bagi Penuntut Umum">
  <data key="d0">hak</data>
  <data key="d1">Penuntut umum dapat memperpanjang penahanan tersangka paling lama 10 hari jika diperlukan untuk kepentingan pemeriksaan.</data>
  <data key="d2">chunk-0027</data>
</node>
<node id="Pasal 73B ayat (4) UU Perikanan versi UU Nomor 45 Tahun 2009">
  <data key="d0">struktur</data>
  <data key="d1">Rumusan Pasal 73B ayat (4) menurut UU Nomor 45 Tahun 2009: ketentuan pengeluaran tersangka dari tahanan.</data>
  <data key="d2">chunk-0027</data>
</node>
<node id="Kewajiban Mengeluarkan Tersangka dari Tahanan demi Hukum">
  <data key="d0">kewajiban</data>
  <data key="d1">Penyidik harus mengeluarkan tersangka dari tahanan demi hukum setelah 30 hari jika kepentingan pemeriksaan terpenuhi. Penyidik harus sudah mengeluarkan tersangka dari tahanan demi hukum setelah 30 hari.</data>
  <data key="d2">chunk-0027</data>
</node>
<node id="Pasal 73B ayat (5) UU Perikanan versi UU Nomor 45 Tahun 2009">
  <data key="d0">struktur</data>
  <data key="d1">Rumusan Pasal 73B ayat (5) menurut UU Nomor 45 Tahun 2009: kewajiban pengeluaran tersangka demi hukum.</data>
  <data key="d2">chunk-0027</data>
</node>
<node id="Pasal 73B ayat (6) UU Perikanan versi UU Nomor 45 Tahun 2009">
  <data key="d0">struktur</data>
  <data key="d1">Rumusan Pasal 73B ayat (6) menurut UU Nomor 45 Tahun 2009: kewajiban penyidik menyampaikan hasil penyidikan.</data>
  <data key="d2">chunk-0027</data>
</node>
<node id="Kewajiban Menyampaikan Hasil Penyidikan bagi Penyidik">
  <data key="d0">kewajiban</data>
  <data key="d1">Penyidik wajib menyampaikan hasil penyidikan ke penuntut umum paling lama 30 hari sejak pemberitahuan dimulainya penyidikan.</data>
  <data key="d2">chunk-0027</data>
</node>
