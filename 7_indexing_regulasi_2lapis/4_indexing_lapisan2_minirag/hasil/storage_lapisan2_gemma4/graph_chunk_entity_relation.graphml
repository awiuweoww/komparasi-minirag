</node>
<node id="Kewajiban Pemerintah Melakukan Sosialisasi">
  <data key="d0">kewajiban</data>
  <data key="d1">Pemerintah melakukan sosialisasi bahan baku, bahan tambahan makanan, bahan penolong, dan/atau alat yang membahayakan kesehatan manusia dan/atau lingkungan.</data>
  <data key="d2">chunk-0010</data>
</node>
<node id="Pasal 25 ayat (1) UU Perikanan versi UU Nomor 45 Tahun 2009">
  <data key="d0">struktur</data>
  <data key="d1">Rumusan Pasal 25 ayat (1) menurut UU Nomor 45 Tahun 2009: sistem bisnis perikanan.</data>
  <data key="d2">chunk-0010</data>
</node>
<node id="Konsep Sistem Bisnis Perikanan">
  <data key="d0">konsep</data>
  <data key="d1">Sistem bisnis perikanan yang meliputi praproduksi, produksi, pengolahan, dan pemasaran.</data>
  <data key="d2">chunk-0010</data>
</node>
<node id="Pasal 25 ayat (2) UU Perikanan versi UU Nomor 45 Tahun 2009">
  <data key="d0">struktur</data>
  <data key="d1">Rumusan Pasal 25 ayat (2) menurut UU Nomor 45 Tahun 2009: delegasi pengaturan ke Peraturan Menteri.</data>
  <data key="d2">chunk-0010</data>
</node>
<node id="Kewajiban Pengaturan Lebih Lanjut oleh Peraturan Menteri">
  <data key="d0">kewajiban</data>
  <data key="d1">Ketentuan lebih lanjut mengenai praproduksi, produksi, pengolahan, dan pemasaran diatur dalam Peraturan Menteri.</data>
  <data key="d2">chunk-0010</data>
</node>
<node id="Pasal 25A UU Perikanan versi UU Nomor 45 Tahun 2009">
  <data key="d0">struktur</data>
  <data key="d1">Rumusan Pasal 25A dalam UU Nomor 45 Tahun 2009: standar mutu hasil perikanan dan peran pemerintah.</data>
  <data key="d2">chunk-0011</data>
</node>
<node id="Pasal 25B UU Perikanan versi UU Nomor 45 Tahun 2009">
  <data key="d0">struktur</data>
  <data key="d1">Rumusan Pasal 25B dalam UU Nomor 45 Tahun 2009: kewajiban pemerintah dalam pemasaran dan iklim usaha.</data>
  <data key="d2">chunk-0011</data>
</node>
<node id="Pasal 25C UU Perikanan versi UU Nomor 45 Tahun 2009">
  <data key="d0">struktur</data>
  <data key="d1">Rumusan Pasal 25C dalam UU Nomor 45 Tahun 2009: pembinaan industri perikanan nasional.</data>
  <data key="d2">chunk-0011</data>
</node>
<node id="Kewajiban Memperhatikan Standar Mutu Hasil Perikanan bagi Pelaku Usaha Perikanan">
  <data key="d0">kewajiban</data>
  <data key="d1">Pelaku usaha perikanan dalam melaksanakan bisnis perikanan harus memperhatikan standar mutu hasil perikanan.</data>
  <data key="d2">chunk-0011</data>
</node>
<node id="Pelaku Usaha Perikanan">
  <data key="d0">pihak</data>
  <data key="d1">Pihak yang melakukan bisnis perikanan.</data>
  <data key="d2">chunk-0011</data>
</node>
<node id="Standar Mutu Hasil Perikanan">
  <data key="d0">konsep</data>
  <data key="d1">Standar mutu yang harus diperhatikan dalam bisnis perikanan.</data>
  <data key="d2">chunk-0011</data>
</node>
<node id="Kewajiban Membina dan Memfasilitasi Pengembangan Usaha Perikanan bagi Pemerintah">
  <data key="d0">kewajiban</data>
  <data key="d1">Pemerintah dan pemerintah daerah membina dan memfasilitasi pengembangan usaha perikanan agar memenuhi standar mutu hasil perikanan.</data>
  <data key="d2">chunk-0011</data>
</node>
<node id="Kewajiban Menyelenggarakan dan Memfasilitasi Kegiatan Pemasaran Usaha Perikanan bagi Pemerintah">
  <data key="d0">kewajiban</data>
  <data key="d1">Pemerintah berkewajiban menyelenggarakan dan memfasilitasi kegiatan pemasaran usaha perikanan baik di dalam negeri maupun ke luar negeri.</data>
  <data key="d2">chunk-0011</data>
</node>
<node id="Kewajiban Menciptakan Iklim Usaha Perikanan yang Sehat bagi Pemerintah">
  <data key="d0">kewajiban</data>
  <data key="d1">Pemerintah berkewajiban menciptakan iklim usaha perikanan yang sehat sesuai dengan ketentuan peraturan perundang-undangan.</data>
  <data key="d2">chunk-0011</data>
</node>
<node id="Kewajiban Membina dan Memfasilitasi Berkembangnya Industri Perikanan Nasional bagi Pemerintah">
  <data key="d0">kewajiban</data>
  <data key="d1">Pemerintah membina dan memfasilitasi berkembangnya industri perikanan nasional dengan mengutamakan penggunaan bahan baku dan sumber daya manusia dalam negeri.</data>
  <data key="d2">chunk-0011</data>
</node>
<node id="Kewajiban Membina Terselenggaranya Kebersamaan dan Kemitraan yang Sehat bagi Pemerintah">
  <data key="d0">kewajiban</data>
  <data key="d1">Pemerintah membina terselenggaranya kebersamaan dan kemitraan yang sehat antara industri perikanan, nelayan dan/atau koperasi perikanan.</data>
  <data key="d2">chunk-0011</data>
</node>
<node id="Koperasi Perikanan">
  <data key="d0">pihak</data>
  <data key="d1">Lembaga koperasi yang menjadi mitra dalam industri perikanan. Lembaga koperasi yang dapat menerima penyerahan kapal perikanan yang dirampas.</data>
  <data key="d2">chunk-0011</data>
</node>
