  <data key="d0">konsep</data>
  <data key="d1">Alat yang membantu proses penangkapan ikan. Alat yang digunakan untuk membantu proses penangkapan ikan.</data>
  <data key="d2">chunk-0006</data>
</node>
<node id="Daerah, Jalur, dan Waktu atau Musim Penangkapan Ikan">
