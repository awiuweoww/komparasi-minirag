  <data key="d0">pihak</data>
  <data key="d1">Subjek hukum warga negara Indonesia.</data>
  <data key="d2">chunk-0025</data>
</node>
<node id="Warga Negara Asing">
  <data key="d0">pihak</data>
  <data key="d1">Subjek hukum warga negara asing.</data>
  <data key="d2">chunk-0025</data>
</node>
