</node>
<node id="Syarat Penuntut Umum Perkara Perikanan">
  <data key="d0">kewajiban</data>
  <data key="d1">Penuntut umum harus berpengalaman minimal 2 tahun, mengikuti pendidikan teknis perikanan, dan memiliki integritas moral.</data>
  <data key="d2">chunk-0028</data>
</node>
<node id="Kewajiban Memberitahukan Hasil Penelitian">
  <data key="d0">kewajiban</data>
  <data key="d1">Penuntut umum wajib memberitahukan hasil penelitiannya kepada penyidik dalam waktu 5 hari sejak berkas diterima.</data>
  <data key="d2">chunk-0028</data>
</node>
<node id="Kewajiban Mengembalikan Berkas Perkara Tidak Lengkap">
  <data key="d0">kewajiban</data>
  <data key="d1">Penuntut umum harus mengembalikan berkas perkara yang tidak lengkap disertai petunjuk kepada penyidik.</data>
