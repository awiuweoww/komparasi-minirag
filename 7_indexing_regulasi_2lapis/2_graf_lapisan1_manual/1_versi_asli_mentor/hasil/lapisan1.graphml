      <data key="d36">uu/2004/31</data>
      <data key="d5">66A</data>
    </node>
    <node id="uu/2004/31/pasal/66B">
      <data key="d0">Pasal</data>
      <data key="d22">Pasal 66B UU Perikanan</data>
      <data key="d36">uu/2004/31</data>
      <data key="d5">66B</data>
