      <data key="d0">VersiPasal</data>
      <data key="d22">Pasal 73 ayat (5) UU Perikanan versi UU Nomor 45 Tahun 2009</data>
      <data key="d41">uu/2004/31/pasal/73/ayat/5</data>
      <data key="d13">uu/2009/45</data>
      <data key="d39">diubah</data>
      <data key="d42">(5) Untuk melakukan koordinasi dalam penanganan tindak pidana di bidang perikanan sebagaimana dimaksud pada ayat (4), Menteri membentuk forum koordinasi.</data>
