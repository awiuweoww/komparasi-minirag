      <data key="d13">uu/2009/45</data>
      <data key="d39">disisipkan</data>
      <data key="d42">(1) Pengawas perikanan sebagaimana dimaksud dalam Pasal 66 melaksanakan tugas di:</data>
      <data key="d43">2009-10-29</data>
      <data key="d44">otomatis</data>
    </node>
    <node id="uu/2004/31/pasal/66B/ayat/2">
