      <data key="d32">Pasal 90A dalam Pasal 81 angka 31 Lampiran</data>
      <data key="d33">inkonstitusional_bersyarat</data>
      <data key="d34">Upah di atas Upah minimum ditetapkan berdasarkan kesepakatan antara Pengusaha dan Pekerja/Buruh atau Serikat Pekerja/Serikat Buruh di perusahaan</data>
      <data key="d35">uu/2023/6</data>
