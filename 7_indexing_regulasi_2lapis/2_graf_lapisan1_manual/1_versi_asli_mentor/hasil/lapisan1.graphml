      <data key="d22">Pasal 76C ayat (5) UU Perikanan</data>
      <data key="d36">uu/2004/31</data>
      <data key="d5">76C</data>
      <data key="d45">5</data>
    </node>
    <node id="uu/2004/31/pasal/76C/ayat/5@uu/2009/45">
      <data key="d0">VersiPasal</data>
      <data key="d22">Pasal 76C ayat (5) UU Perikanan versi UU Nomor 45 Tahun 2009</data>
      <data key="d41">uu/2004/31/pasal/76C/ayat/5</data>
      <data key="d13">uu/2009/45</data>
      <data key="d39">disisipkan</data>
      <data key="d42">(5) Benda dan/atau alat yang dirampas dari hasil tindak pidana perikanan yang berupa kapal perikanan dapat diserahkan kepada kelompok usaha bersama nelayan dan/atau koperasi perikanan.</data>
      <data key="d43">2009-10-29</data>
      <data key="d44">otomatis</data>
    </node>
    <node id="uu/2004/31/pasal/76C/ayat/6">
      <data key="d0">Pasal</data>
      <data key="d22">Pasal 76C ayat (6) UU Perikanan</data>
      <data key="d36">uu/2004/31</data>
      <data key="d5">76C</data>
      <data key="d45">6</data>
    </node>
    <node id="uu/2004/31/pasal/76C/ayat/6@uu/2009/45">
      <data key="d0">VersiPasal</data>
      <data key="d22">Pasal 76C ayat (6) UU Perikanan versi UU Nomor 45 Tahun 2009</data>
      <data key="d41">uu/2004/31/pasal/76C/ayat/6</data>
      <data key="d13">uu/2009/45</data>
      <data key="d39">disisipkan</data>
      <data key="d42">(6) Ketentuan lebih lanjut mengenai pemberian penghargaan diatur dengan Peraturan Pemerintah.</data>
      <data key="d43">2009-10-29</data>
      <data key="d44">otomatis</data>
    </node>
    <node id="uu/2004/31/pasal/78A">
      <data key="d0">Pasal</data>
      <data key="d22">Pasal 78A UU Perikanan</data>
      <data key="d36">uu/2004/31</data>
      <data key="d5">78A</data>
    </node>
    <node id="uu/2009/45/pasal/I/angka/37">
      <data key="d0">PeristiwaPerubahan</data>
      <data key="d22">UU Nomor 45 Tahun 2009 Pasal I angka 37</data>
      <data key="d37">uu/2009/45</data>
      <data key="d28">Pasal I</data>
      <data key="d38">37</data>
      <data key="d39">sisip</data>
      <data key="d40">37. Di antara Pasal 78 dan Pasal 79 disisipkan 1 (satu) pasal yakni Pasal 78A, yang berbunyi sebagai berikut:</data>
    </node>
    <node id="uu/2004/31/pasal/78A@uu/2009/45">
      <data key="d0">VersiPasal</data>
      <data key="d22">Pasal 78A UU Perikanan versi UU Nomor 45 Tahun 2009</data>
      <data key="d41">uu/2004/31/pasal/78A</data>
      <data key="d13">uu/2009/45</data>
      <data key="d39">disisipkan</data>
      <data key="d42">(1) Setiap pengadilan negeri yang telah ada pengadilan perikanan, dibentuk subkepaniteraan pengadilan perikanan yang dipimpin oleh seorang panitera muda. (2) Dalam melaksanakan tugasnya, panitera muda sebagaimana dimaksud pada ayat (1) dibantu oleh beberapa orang panitera pengganti. (3) Panitera muda dan panitera pengganti pengadilan perikanan berasal dari lingkungan pengadilan negeri. (4) Ketentuan mengenai persyaratan, tata cara pengangkatan, dan pemberhentian panitera muda dan panitera pengganti pengadilan perikanan serta susunan organisasi, tugas, dan tata kerja subkepaniteraan pengadilan perikanan diatur dengan peraturan Mahkamah Agung sesuai dengan ketentuan peraturan perundang-undangan.</data>
      <data key="d43">2009-10-29</data>
      <data key="d44">otomatis</data>
    </node>
    <node id="uu/2004/31/pasal/78A/ayat/1">
      <data key="d0">Pasal</data>
