      <data key="d22">Pasal 18 UU Perikanan</data>
      <data key="d36">uu/2004/31</data>
      <data key="d5">18</data>
    </node>
    <node id="uu/2009/45/pasal/I/angka/7">
      <data key="d0">PeristiwaPerubahan</data>
      <data key="d22">UU Nomor 45 Tahun 2009 Pasal I angka 7</data>
      <data key="d37">uu/2009/45</data>
      <data key="d28">Pasal I</data>
      <data key="d38">7</data>
      <data key="d39">ubah</data>
      <data key="d40">7. Ketentuan Pasal 18 ditambah 2 (dua) ayat yakni ayat (3) dan ayat (4), sehingga Pasal 18 berbunyi sebagai berikut:</data>
    </node>
    <node id="uu/2004/31/pasal/18@uu/2009/45">
      <data key="d0">VersiPasal</data>
      <data key="d22">Pasal 18 UU Perikanan versi UU Nomor 45 Tahun 2009</data>
      <data key="d41">uu/2004/31/pasal/18</data>
      <data key="d13">uu/2009/45</data>
      <data key="d39">diubah</data>
      <data key="d42">(1) Pemerintah mengatur dan membina tata pemanfaatan air dan lahan pembudidayaan ikan. (2) Pengaturan dan pembinaan tata pemanfaatan air dan lahan pembudidayaan ikan, sebagaimana dimaksud pada ayat (1) dilakukan dalam rangka menjamin kuantitas dan kualitas air untuk kepentingan pembudidayaan ikan. (3) Pelaksanaan tata pemanfaatan air dan lahan pembudidayaan ikan dilakukan oleh pemerintah daerah. (4) Ketentuan lebih lanjut mengenai pengaturan dan pembinaan tata pemanfaatan air dan lahan pembudidayaan ikan sebagaimana dimaksud pada ayat (1) dan ayat (2) diatur dengan Peraturan Pemerintah.</data>
      <data key="d43">2009-10-29</data>
      <data key="d44">otomatis</data>
    </node>
    <node id="uu/2004/31/pasal/18/ayat/1">
      <data key="d0">Pasal</data>
