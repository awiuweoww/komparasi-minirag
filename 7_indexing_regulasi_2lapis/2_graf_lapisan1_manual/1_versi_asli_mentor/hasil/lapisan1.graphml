      <data key="d38">31</data>
      <data key="d39">sisip</data>
      <data key="d40">31. Di antara Pasal 71 dan Pasal 72 disisipkan 1 (satu) pasal yakni Pasal 71A, yang berbunyi sebagai berikut:</data>
    </node>
    <node id="uu/2004/31/pasal/71A@uu/2009/45">
      <data key="d0">VersiPasal</data>
      <data key="d22">Pasal 71A UU Perikanan versi UU Nomor 45 Tahun 2009</data>
      <data key="d41">uu/2004/31/pasal/71A</data>
      <data key="d13">uu/2009/45</data>
      <data key="d39">disisipkan</data>
      <data key="d42">Pengadilan perikanan berwenang memeriksa, mengadili, dan memutuskan perkara tindak pidana di bidang perikanan yang terjadi di wilayah pengelolaan perikanan Negara Republik Indonesia, baik yang dilakukan oleh warga negara Indonesia maupun warga negara asing.</data>
      <data key="d43">2009-10-29</data>
      <data key="d44">otomatis</data>
    </node>
