      <data key="d39">diubah</data>
      <data key="d42">(3) Pengawasan tertib pelaksanaan peraturan perundang-undangan sebagaimana dimaksud pada ayat (2) meliputi:</data>
      <data key="d43">2009-10-29</data>
      <data key="d44">otomatis</data>
    </node>
