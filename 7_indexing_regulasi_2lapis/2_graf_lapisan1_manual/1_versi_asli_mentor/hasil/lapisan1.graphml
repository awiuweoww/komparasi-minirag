    <node id="uu/2004/31/pasal/73B/ayat/6@uu/2009/45">
      <data key="d0">VersiPasal</data>
      <data key="d22">Pasal 73B ayat (6) UU Perikanan versi UU Nomor 45 Tahun 2009</data>
