    <node id="putusan/mk/273-puu-xxiii-2025/amar/1">
      <data key="d0">ButirAmar</data>
      <data key="d22">Putusan MK Nomor 273/PUU-XXIII/2025 amar 1</data>
      <data key="d31">putusan/mk/273-puu-xxiii-2025</data>
      <data key="d5">1</data>
      <data key="d32">Pasal 28 ayat (1) dalam Pasal 71 angka 2 Lampiran</data>
      <data key="d33">inkonstitusional_bersyarat</data>
      <data key="d34">Besaran tarif penyelenggaraan jaringan telekomunikasi dan/atau penyelenggaraan jasa telekomunikasi ditetapkan oleh penyelenggara jaringan telekomunikasi dan/atau jasa telekomunikasi berdasarkan formula yang ditetapkan oleh Pemerintah Pusat dengan kewajiban menyediakan pilihan layanan jasa telekomunikasi yang menjamin sisa kuota milik pengguna jasa telekomunikasi tetap aktif dan dapat digunakan</data>
      <data key="d35">uu/2023/6</data>
    </node>
    <node id="putusan/mk/168-puu-xxi-2023">
      <data key="d0">PutusanPengadilan</data>
      <data key="d22">Putusan MK Nomor 168/PUU-XXI/2023</data>
      <data key="d30">MK</data>
    </node>
    <node id="putusan/mk/168-puu-xxi-2023/amar/1">
      <data key="d0">ButirAmar</data>
      <data key="d22">Putusan MK Nomor 168/PUU-XXI/2023 amar 1</data>
      <data key="d31">putusan/mk/168-puu-xxi-2023</data>
      <data key="d5">1</data>
      <data key="d32">Pasal 42 ayat (1) dalam Pasal 81 angka 4 Lampiran</data>
      <data key="d33">inkonstitusional_bersyarat</data>
      <data key="d34">menteri yang bertanggungjawab di bidang (urusan) ketenagakerjaan, in casu menteri Tenaga Kerja</data>
      <data key="d35">uu/2023/6</data>
    </node>
    <node id="putusan/mk/168-puu-xxi-2023/amar/2">
      <data key="d0">ButirAmar</data>
      <data key="d22">Putusan MK Nomor 168/PUU-XXI/2023 amar 2</data>
      <data key="d31">putusan/mk/168-puu-xxi-2023</data>
      <data key="d5">2</data>
      <data key="d32">Pasal 42 ayat (4) dalam Pasal 81 angka 4 Lampiran</data>
      <data key="d33">inkonstitusional_bersyarat</data>
      <data key="d34">Tenaga Kerja Asing dapat dipekerjakan di Indonesia hanya dalam Hubungan Kerja untuk jabatan tertentu dan waktu tertentu serta memiliki kompetensi sesuai dengan jabatan yang akan diduduki, dengan memerhatikan pengutamaan penggunaan tenaga kerja Indonesia</data>
      <data key="d35">uu/2023/6</data>
    </node>
    <node id="putusan/mk/168-puu-xxi-2023/amar/3">
      <data key="d0">ButirAmar</data>
      <data key="d22">Putusan MK Nomor 168/PUU-XXI/2023 amar 3</data>
      <data key="d31">putusan/mk/168-puu-xxi-2023</data>
      <data key="d5">3</data>
      <data key="d32">Pasal 56 ayat (3) dalam Pasal 81 angka 12 Lampiran</data>
      <data key="d33">inkonstitusional_bersyarat</data>
      <data key="d34">Jangka waktu selesainya suatu pekerjaan tertentu dibuat tidak melebihi paling lama 5 (lima) tahun, termasuk jika terdapat perpanjangan</data>
      <data key="d35">uu/2023/6</data>
    </node>
    <node id="putusan/mk/168-puu-xxi-2023/amar/4">
      <data key="d0">ButirAmar</data>
      <data key="d22">Putusan MK Nomor 168/PUU-XXI/2023 amar 4</data>
      <data key="d31">putusan/mk/168-puu-xxi-2023</data>
      <data key="d5">4</data>
      <data key="d32">Pasal 57 ayat (1) dalam Pasal 81 angka 13 Lampiran</data>
      <data key="d33">inkonstitusional_bersyarat</data>
      <data key="d34">Perjanjian kerja waktu tertentu harus dibuat secara tertulis dengan menggunakan bahasa Indonesia dan huruf latin</data>
      <data key="d35">uu/2023/6</data>
    </node>
    <node id="putusan/mk/168-puu-xxi-2023/amar/5">
      <data key="d0">ButirAmar</data>
      <data key="d22">Putusan MK Nomor 168/PUU-XXI/2023 amar 5</data>
      <data key="d31">putusan/mk/168-puu-xxi-2023</data>
      <data key="d5">5</data>
      <data key="d32">Pasal 64 ayat (2) dalam Pasal 81 angka 18 Lampiran</data>
      <data key="d33">inkonstitusional_bersyarat</data>
      <data key="d34">Menteri menetapkan sebagian pelaksanaan pekerjaan sebagaimana dimaksud pada ayat (1) sesuai dengan jenis dan bidang pekerjaan alih daya yang diperjanjikan dalam perjanjian tertulis alih daya</data>
      <data key="d35">uu/2023/6</data>
    </node>
    <node id="putusan/mk/168-puu-xxi-2023/amar/6">
      <data key="d0">ButirAmar</data>
      <data key="d22">Putusan MK Nomor 168/PUU-XXI/2023 amar 6</data>
      <data key="d31">putusan/mk/168-puu-xxi-2023</data>
      <data key="d5">6</data>
      <data key="d32">Pasal 79 ayat (2) huruf b dalam Pasal 81 angka 25 Lampiran</data>
      <data key="d33">inkonstitusional_bersyarat</data>
      <data key="d34">atau 2 (dua) hari untuk 5 (lima) hari kerja dalam 1 (satu) minggu</data>
      <data key="d35">uu/2023/6</data>
    </node>
    <node id="putusan/mk/168-puu-xxi-2023/amar/7">
      <data key="d0">ButirAmar</data>
      <data key="d22">Putusan MK Nomor 168/PUU-XXI/2023 amar 7</data>
      <data key="d31">putusan/mk/168-puu-xxi-2023</data>
      <data key="d5">7</data>
      <data key="d32">Pasal 79 ayat (5) dalam Pasal 81 angka 25 Lampiran</data>
      <data key="d33">tidak_mengikat</data>
      <data key="d35">uu/2023/6</data>
    </node>
    <node id="putusan/mk/168-puu-xxi-2023/amar/8">
      <data key="d0">ButirAmar</data>
      <data key="d22">Putusan MK Nomor 168/PUU-XXI/2023 amar 8</data>
      <data key="d31">putusan/mk/168-puu-xxi-2023</data>
      <data key="d5">8</data>
      <data key="d32">Pasal 88 ayat (1) dalam Pasal 81 angka 27 Lampiran</data>
      <data key="d33">inkonstitusional_bersyarat</data>
      <data key="d34">termasuk penghasilan yang memenuhi penghidupan yang merupakan jumlah penerimaan atau pendapatan pekerja/buruh dari hasil pekerjaannya sehingga mampu memenuhi kebutuhan hidup pekerja/buruh dan keluarganya secara wajar yang meliputi makanan dan minuman, sandang, perumahan, pendidikan, kesehatan, rekreasi, dan jaminan hari tua</data>
      <data key="d35">uu/2023/6</data>
    </node>
    <node id="putusan/mk/168-puu-xxi-2023/amar/9">
