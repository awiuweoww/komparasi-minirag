      <data key="d38">26</data>
      <data key="d39">ubah</data>
      <data key="d40">26. Ketentuan Pasal 65 ayat (1) dihapus sehingga Pasal 65 berbunyi sebagai berikut:</data>
    </node>
    <node id="uu/2004/31/pasal/65@uu/2009/45">
