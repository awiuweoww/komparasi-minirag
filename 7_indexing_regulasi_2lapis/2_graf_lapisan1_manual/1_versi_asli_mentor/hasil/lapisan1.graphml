      <data key="d39">ubah</data>
      <data key="d40">2. Ketentuan Pasal 2 diubah sehingga Pasal 2 berbunyi sebagai berikut:</data>
    </node>
    <node id="uu/2004/31/pasal/2@uu/2009/45">
      <data key="d0">VersiPasal</data>
      <data key="d22">Pasal 2 UU Perikanan versi UU Nomor 45 Tahun 2009</data>
      <data key="d41">uu/2004/31/pasal/2</data>
      <data key="d13">uu/2009/45</data>
      <data key="d39">diubah</data>
      <data key="d42">Pengelolaan perikanan dilakukan berdasarkan asas: a. manfaat; b. keadilan; c. kebersamaan; d. kemitraan; e. kemandirian; f. pemerataan; g. keterpaduan; h. keterbukaan; i. efisiensi; j. kelestarian; dan k. pembangunan yang berkelanjutan.</data>
      <data key="d43">2009-10-29</data>
