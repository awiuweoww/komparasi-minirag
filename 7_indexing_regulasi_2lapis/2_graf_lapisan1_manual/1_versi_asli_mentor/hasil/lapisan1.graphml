      <data key="d41">uu/2004/31/pasal/25A/ayat/2</data>
      <data key="d13">uu/2009/45</data>
      <data key="d39">disisipkan</data>
      <data key="d42">(2) Pemerintah dan pemerintah daerah membina dan memfasilitasi pengembangan usaha perikanan agar memenuhi standar mutu hasil perikanan.</data>
      <data key="d43">2009-10-29</data>
