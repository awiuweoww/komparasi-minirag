      <data key="d41">uu/2004/31/pasal/65</data>
      <data key="d13">uu/2009/45</data>
      <data key="d39">diubah</data>
      <data key="d42">Pemerintah dapat memberikan tugas kepada pemerintah daerah untuk melaksanakan urusan tugas pembantuan di bidang perikanan.</data>
      <data key="d43">2009-10-29</data>
      <data key="d44">otomatis</data>
    </node>
    <node id="uu/2004/31/pasal/66">
