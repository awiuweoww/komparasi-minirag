   "menguji": [
    {
     "id": "uu/2023/6",
     "sasaran": "Pasal 42 ayat (1) dalam Pasal 81 angka 4 Lampiran",
     "unsur": "frasa",
     "jenis_amar": "inkonstitusional_bersyarat",
     "tafsir": "menteri yang bertanggungjawab di bidang (urusan) ketenagakerjaan, in casu menteri Tenaga Kerja"
    },
    {
     "id": "uu/2023/6",
     "sasaran": "Pasal 42 ayat (4) dalam Pasal 81 angka 4 Lampiran",
     "unsur": "pasal",
     "jenis_amar": "inkonstitusional_bersyarat",
     "tafsir": "Tenaga Kerja Asing dapat dipekerjakan di Indonesia hanya dalam Hubungan Kerja untuk jabatan tertentu dan waktu tertentu serta memiliki kompetensi sesuai dengan jabatan yang akan diduduki, dengan memerhatikan pengutamaan penggunaan tenaga kerja Indonesia"
    },
    {
     "id": "uu/2023/6",
     "sasaran": "Pasal 56 ayat (3) dalam Pasal 81 angka 12 Lampiran",
     "unsur": "pasal",
     "jenis_amar": "inkonstitusional_bersyarat",
     "tafsir": "Jangka waktu selesainya suatu pekerjaan tertentu dibuat tidak melebihi paling lama 5 (lima) tahun, termasuk jika terdapat perpanjangan"
    },
    {
     "id": "uu/2023/6",
     "sasaran": "Pasal 57 ayat (1) dalam Pasal 81 angka 13 Lampiran",
     "unsur": "pasal",
     "jenis_amar": "inkonstitusional_bersyarat",
     "tafsir": "Perjanjian kerja waktu tertentu harus dibuat secara tertulis dengan menggunakan bahasa Indonesia dan huruf latin"
    },
    {
     "id": "uu/2023/6",
     "sasaran": "Pasal 64 ayat (2) dalam Pasal 81 angka 18 Lampiran",
     "unsur": "pasal",
     "jenis_amar": "inkonstitusional_bersyarat",
     "tafsir": "Menteri menetapkan sebagian pelaksanaan pekerjaan sebagaimana dimaksud pada ayat (1) sesuai dengan jenis dan bidang pekerjaan alih daya yang diperjanjikan dalam perjanjian tertulis alih daya"
    },
    {
     "id": "uu/2023/6",
     "sasaran": "Pasal 79 ayat (2) huruf b dalam Pasal 81 angka 25 Lampiran",
     "unsur": "pasal",
     "jenis_amar": "inkonstitusional_bersyarat",
     "tafsir": "atau 2 (dua) hari untuk 5 (lima) hari kerja dalam 1 (satu) minggu"
    },
    {
     "id": "uu/2023/6",
     "sasaran": "Pasal 79 ayat (5) dalam Pasal 81 angka 25 Lampiran",
     "unsur": "kata",
     "jenis_amar": "tidak_mengikat",
     "tafsir": null
    },
    {
     "id": "uu/2023/6",
     "sasaran": "Pasal 88 ayat (1) dalam Pasal 81 angka 27 Lampiran",
     "unsur": "pasal",
     "jenis_amar": "inkonstitusional_bersyarat",
     "tafsir": "termasuk penghasilan yang memenuhi penghidupan yang merupakan jumlah penerimaan atau pendapatan pekerja/buruh dari hasil pekerjaannya sehingga mampu memenuhi kebutuhan hidup pekerja/buruh dan keluarganya secara wajar yang meliputi makanan dan minuman, sandang, perumahan, pendidikan, kesehatan, rekreasi, dan jaminan hari tua"
    },
    {
     "id": "uu/2023/6",
     "sasaran": "Pasal 88 ayat (2) dalam Pasal 81 angka 27 Lampiran",
     "unsur": "pasal",
     "jenis_amar": "inkonstitusional_bersyarat",
     "tafsir": "dengan melibatkan dewan pengupahan daerah yang di dalamnya terdapat unsur pemerintah daerah dalam perumusan kebijakan pengupahan yang menjadi bahan bagi pemerintah pusat untuk penetapan kebijakan pengupahan"
    },
    {
     "id": "uu/2023/6",
     "sasaran": "Pasal 88 ayat (3) huruf b dalam Pasal 81 angka 27 Lampiran",
     "unsur": "frasa",
     "jenis_amar": "inkonstitusional_bersyarat",
     "tafsir": "struktur dan skala upah yang proporsional"
    },
    {
     "id": "uu/2023/6",
     "sasaran": "Pasal 88C dalam Pasal 81 angka 28 Lampiran",
     "unsur": "pasal",
     "jenis_amar": "inkonstitusional_bersyarat",
     "tafsir": "termasuk gubernur wajib menetapkan upah minimum sektoral pada wilayah provinsi dan dapat untuk kabupaten/kota"
    },
    {
     "id": "uu/2023/6",
     "sasaran": "Pasal 88D ayat (2) dalam Pasal 81 angka 28 Lampiran",
     "unsur": "frasa",
     "jenis_amar": "inkonstitusional_bersyarat",
     "tafsir": "indeks tertentu merupakan variabel yang mewakili kontribusi tenaga kerja terhadap pertumbuhan ekonomi provinsi atau kabupaten/kota dengan memperhatikan kepentingan perusahaan dan pekerja/buruh serta prinsip proporsionalitas untuk memenuhi kebutuhan hidup layak (KHL) bagi pekerja/buruh"
    },
    {
     "id": "uu/2023/6",
     "sasaran": "Pasal 88F dalam Pasal 81 angka 28 Lampiran",
     "unsur": "frasa",
     "jenis_amar": "inkonstitusional_bersyarat",
     "tafsir": "Yang dimaksud dengan "
    },
    {
