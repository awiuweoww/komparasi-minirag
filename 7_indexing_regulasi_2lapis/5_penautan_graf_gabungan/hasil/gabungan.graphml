  <data key="d0">kewajiban</data>
  <data key="d3">Setiap orang wajib melestarikan plasma nutfah yang berkaitan dengan sumber daya ikan.</data>
  <data key="d4">chunk-0008</data>
  <data key="d2">2</data>
  <data key="d5">uu/2004/31/pasal/14@uu/2009/45</data>
  <data key="d6">uu/2009/45</data>
</node>
<node id="Hak Mengendalikan Pemasukan dan/atau Pengeluaran Ikan Jenis Baru">
  <data key="d0">hak</data>
  <data key="d3">Pemerintah mengendalikan pemasukan dan/atau pengeluaran ikan jenis baru dari dan ke luar negeri dan/atau lalu lintas antarpulau.</data>
