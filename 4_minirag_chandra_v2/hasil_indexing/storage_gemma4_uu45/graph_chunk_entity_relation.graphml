  <data key="d0">Pendidikan Penyidik PNS Perikanan</data>
  <data key="d1">kewajiban</data>
  <data key="d2">Proses pendidikan bagi pengawas perikanan untuk menjadi penyidik.</data>
  <data key="d3">chunk-0024</data>
</node>
