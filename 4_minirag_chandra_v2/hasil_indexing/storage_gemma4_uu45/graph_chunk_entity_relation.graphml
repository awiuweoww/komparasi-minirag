  <data key="d1">pihak</data>
  <data key="d2">Lembaga yang bertugas mengkaji sumber daya ikan sebagai dasar rekomendasi kebijakan. Lembaga yang dibentuk oleh Menteri untuk mengkaji sumber daya ikan dan memberikan rekomendasi.</data>
  <data key="d3">chunk-0008</data>
</node>
<node id="kewajiban kepatuhan pengelolaan perikanan">
