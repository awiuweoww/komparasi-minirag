  <data key="d0">Sentra Kegiatan Perikanan</data>
  <data key="d1">konsep</data>
  <data key="d2">Pusat kegiatan yang berkaitan dengan industri atau aktivitas perikanan.</data>
  <data key="d3">chunk-0025</data>
</node>
<node id="area pembenihan ikan">
  <data key="d0">Area Pembenihan Ikan</data>
  <data key="d1">konsep</data>
  <data key="d2">Lokasi khusus untuk proses pembenihan ikan.</data>
  <data key="d3">chunk-0025</data>
</node>
<node id="area pembudidayaan ikan">
  <data key="d0">Area Pembudidayaan Ikan</data>
  <data key="d1">konsep</data>
  <data key="d2">Lokasi khusus untuk kegiatan budidaya ikan.</data>
