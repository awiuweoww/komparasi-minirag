  <data key="d1">kewajiban</data>
  <data key="d2">Kewajiban penuntut umum untuk menyerahkan berkas perkara dalam batas waktu 30 hari.</data>
  <data key="d3">chunk-0033</data>
</node>
<node id="perpanjangan penahanan">
  <data key="d0">Perpanjangan Penahanan</data>
  <data key="d1">konsep</data>
  <data key="d2">Perpanjangan masa penahanan oleh ketua pengadilan negeri untuk kepentingan pemeriksaan.</data>
  <data key="d3">chunk-0033</data>
</node>
