</node>
<node id="kas negara">
  <data key="d0">Kas Negara</data>
  <data key="d1">konsep</data>
  <data key="d2">Akun keuangan negara tempat penyetoran uang hasil pelelangan sebagai penerimaan negara bukan pajak. Tempat penyimpanan resmi negara untuk penerimaan negara bukan pajak.</data>
  <data key="d3">chunk-0034</data>
</node>
