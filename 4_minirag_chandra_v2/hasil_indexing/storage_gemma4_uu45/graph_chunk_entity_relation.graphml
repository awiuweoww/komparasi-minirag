  <data key="d1">pihak</data>
  <data key="d2">Salah satu lokasi kedudukan pengadilan perikanan yang ditetapkan secara spesifik.</data>
  <data key="d3">chunk-0028</data>
</node>
<node id="pengadilan negeri bitung">
  <data key="d0">Pengadilan Negeri Bitung</data>
