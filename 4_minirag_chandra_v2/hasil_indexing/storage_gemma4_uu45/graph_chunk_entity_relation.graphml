  <data key="d3">chunk-0001</data>
</node>
<node id="uud negara republik indonesia tahun 1945">
  <data key="d0">UUD Negara Republik Indonesia Tahun 1945</data>
  <data key="d1">dasar_hukum</data>
  <data key="d2">Konstitusi negara yang menjadi landasan filosofis dan hukum tertinggi bagi pengelolaan sumber daya alam.</data>
