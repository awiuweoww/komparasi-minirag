</node>
<node id="sanksi administratif">
  <data key="d0">Sanksi Administratif</data>
  <data key="d1">sanksi</data>
  <data key="d2">Tindakan hukum berupa peringatan, pembekuan izin, atau pencabutan izin atas pelanggaran aturan awak kapal. Tindakan hukum berupa peringatan, pembekuan izin, atau pencabutan izin atas pelanggaran prosedur bongkar muat.</data>
  <data key="d3">chunk-0016</data>
</node>
<node id="pasal 41">
  <data key="d0">Pasal 41</data>
  <data key="d1">struktur</data>
