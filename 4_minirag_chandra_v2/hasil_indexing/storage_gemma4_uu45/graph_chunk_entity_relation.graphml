  <data key="d3">chunk-0006</data>
</node>
<node id="alat penangkapan ikan">
  <data key="d0">Alat Penangkapan Ikan</data>
  <data key="d1">konsep</data>
  <data key="d2">Sarana fisik yang digunakan untuk menangkap ikan, yang pengaturannya mencakup jenis, jumlah, dan ukuran.</data>
  <data key="d3">chunk-0007</data>
</node>
<node id="alat bantu penangkapan ikan">
  <data key="d0">Alat Bantu Penangkapan Ikan</data>
  <data key="d1">konsep</data>
  <data key="d2">Perangkat pendukung penangkapan ikan yang pengaturannya mencakup jenis, jumlah, ukuran, dan penempatan. Perangkat pendukung operasional penangkapan ikan yang dilarang jika merusak keberlanjutan.</data>
  <data key="d3">chunk-0007</data>
</node>
<node id="standar prosedur operasional penangkapan ikan">
