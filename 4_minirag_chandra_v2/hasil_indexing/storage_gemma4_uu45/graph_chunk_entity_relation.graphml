  <data key="d1">hak</data>
  <data key="d2">Hak istimewa bagi nelayan kecil untuk dibebaskan dari kewajiban kepemilikan SIPI dan SIKPI. Hak pengecualian bagi nelayan kecil dan pembudidaya ikan kecil dari kewajiban SIKPI.</data>
  <data key="d3">chunk-0014</data>
</node>
<node id="persetujuan pemerintah">
