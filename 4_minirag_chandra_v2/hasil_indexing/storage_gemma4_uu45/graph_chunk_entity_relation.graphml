  <data key="d0">Syahbandar</data>
  <data key="d1">pihak</data>
  <data key="d2">Pejabat pemerintah di pelabuhan perikanan yang memiliki otoritas untuk mengatur, memeriksa, dan mengawasi kegiatan kapal perikanan. Pejabat yang diangkat untuk mengawasi keselamatan pelayaran dan koordinasinya dengan Menteri.</data>
  <data key="d3">chunk-0020</data>
</node>
<node id="menteri yang membidangi urusan pelayaran">
  <data key="d0">Menteri yang membidangi urusan pelayaran</data>
  <data key="d1">pihak</data>
  <data key="d2">Pejabat tinggi negara yang berwenang mengangkat Syahbandar di pelabuhan perikanan. Pejabat pusat yang berwenang mengangkat Syahbandar di pelabuhan perikanan.</data>
  <data key="d3">chunk-0020</data>
</node>
<node id="surat tanda bukti lapor kedatangan dan keberangkatan kapal perikanan">
  <data key="d0">Surat Tanda Bukti Lapor Kedatangan dan Keberangkatan Kapal Perikanan</data>
  <data key="d1">konsep</data>
  <data key="d2">Dokumen administrasi yang diterbitkan Syahbandar untuk mencatat pergerakan kapal.</data>
  <data key="d3">chunk-0020</data>
</node>
<node id="perjanjian kerja laut">
  <data key="d0">Perjanjian Kerja Laut</data>
  <data key="d1">konsep</data>
  <data key="d2">Kontrak kerja antara awak kapal dengan pengelola kapal yang harus diperiksa dan disahkan.</data>
  <data key="d3">chunk-0020</data>
</node>
<node id="log book penangkapan dan pengangkutan ikan">
  <data key="d0">Log Book Penangkapan dan Pengangkutan Ikan</data>
  <data key="d1">konsep</data>
  <data key="d2">Catatan resmi mengenai aktivitas penangkapan dan distribusi hasil laut yang wajib diperiksa.</data>
  <data key="d3">chunk-0020</data>
</node>
<node id="sertifikat ikan hasil tangkapan">
  <data key="d0">Sertifikat Ikan Hasil Tangkapan</data>
  <data key="d1">konsep</data>
  <data key="d2">Dokumen bukti legalitas hasil tangkapan ikan yang harus diperiksa oleh Syahbandar.</data>
  <data key="d3">chunk-0020</data>
</node>
<node id="kewajiban memiliki surat persetujuan berlayar">
  <data key="d0">Kewajiban Memiliki Surat Persetujuan Berlayar</data>
  <data key="d1">kewajiban</data>
  <data key="d2">Kewajiban hukum bagi setiap kapal perikanan sebelum melakukan penangkapan atau pengangkutan. Kewajiban bagi pelabuhan perikanan untuk memiliki izin berlayar dari Syahbandar.</data>
  <data key="d3">chunk-0020</data>
</node>
<node id="pencarian dan penyelamatan">
  <data key="d0">Pencarian dan Penyelamatan</data>
  <data key="d1">kewajiban</data>
  <data key="d2">Tugas darurat Syahbandar dalam melaksanakan bantuan pencarian dan penyelamatan di laut.</data>
  <data key="d3">chunk-0020</data>
</node>
<node id="penanggulangan pencemaran dan pemadaman kebakaran">
  <data key="d0">Penanggulangan Pencemaran dan Pemadaman Kebakaran</data>
  <data key="d1">kewajiban</data>
  <data key="d2">Tugas pengamanan dan perlindungan lingkungan di area pelabuhan perikanan.</data>
  <data key="d3">chunk-0020</data>
</node>
<node id="pengawasan perlindungan lingkungan maritim">
  <data key="d0">Pengawasan Perlindungan Lingkungan Maritim</data>
  <data key="d1">kewajiban</data>
  <data key="d2">Tugas pengawasan Syahbandar untuk memastikan kepatuhan terhadap aturan lingkungan laut.</data>
  <data key="d3">chunk-0020</data>
