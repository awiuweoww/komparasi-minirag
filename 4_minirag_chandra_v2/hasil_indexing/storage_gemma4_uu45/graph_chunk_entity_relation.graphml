  <data key="d1">konsep</data>
  <data key="d2">Pengawasan arus keluar masuk bahan kimia/obat untuk ikan.</data>
  <data key="d3">chunk-0024</data>
</node>
<node id="konservasi">
  <data key="d0">Konservasi</data>
  <data key="d1">konsep</data>
  <data key="d2">Kegiatan perlindungan dan pelestarian sumber daya perikanan. Upaya perlindungan dan pelestarian sumber daya hayati laut dari kerusakan.</data>
  <data key="d3">chunk-0024</data>
</node>
<node id="pencemaran akibat perbuatan manusia">
  <data key="d0">Pencemaran Akibat Perbuatan Manusia</data>
  <data key="d1">konsep</data>
  <data key="d2">Objek pengawasan terkait dampak lingkungan yang disebabkan oleh aktivitas manusia.</data>
  <data key="d3">chunk-0024</data>
</node>
<node id="penelitian dan pengembangan perikanan">
  <data key="d0">Penelitian dan Pengembangan Perikanan</data>
  <data key="d1">konsep</data>
  <data key="d2">Kegiatan riset di bidang perikanan yang wajib diawasi.</data>
  <data key="d3">chunk-0024</data>
</node>
<node id="ikan hasil rekayasa genetik">
  <data key="d0">Ikan Hasil Rekayasa Genetik</data>
  <data key="d1">konsep</data>
  <data key="d2">Produk perikanan hasil modifikasi genetik yang menjadi objek pengawasan khusus.</data>
  <data key="d3">chunk-0024</data>
</node>
<node id="tugas pengawasan tertib pelaksanaan">
  <data key="d0">Tugas Pengawasan Tertib Pelaksanaan</data>
  <data key="d1">kewajiban</data>
  <data key="d2">Kewajiban pengawas perikanan untuk memastikan kepatuhan terhadap peraturan perundang-undangan.</data>
  <data key="d3">chunk-0024</data>
</node>
<node id="pengangkatan pengawas perikanan">
  <data key="d0">Pengangkatan Pengawas Perikanan</data>
  <data key="d1">kewajiban</data>
  <data key="d2">Prosedur pengangkatan pengawas perikanan oleh Menteri atau pejabat yang ditunjuk.</data>
  <data key="d3">chunk-0024</data>
</node>
