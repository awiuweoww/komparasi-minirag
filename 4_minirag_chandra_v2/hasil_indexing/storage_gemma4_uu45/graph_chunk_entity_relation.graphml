  <data key="d3">chunk-0033</data>
</node>
<node id="pemusnahan barang bukti">
  <data key="d0">Pemusnahan Barang Bukti</data>
  <data key="d1">konsep</data>
  <data key="d2">Penghancuran barang bukti hasil tindak pidana perikanan setelah mendapat persetujuan.</data>
  <data key="d3">chunk-0033</data>
</node>
<node id="pasal 78a">
  <data key="d0">Pasal 78A</data>
  <data key="d1">struktur</data>
  <data key="d2">Pasal yang mengatur pembentukan subkepaniteraan pengadilan perikanan di lingkungan pengadilan negeri. Pasal yang mengatur sanksi pidana terkait pelanggaran perlindungan anak.</data>
