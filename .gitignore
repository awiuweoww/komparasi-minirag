# ==============================================================================
# .gitignore - Pengujian Komparasi MiniRAG
# Mengizinkan push seluruh pipeline & data kecuali skrip pengecekan/evaluasi
# ==============================================================================

# Skrip Evaluasi & Pengecekan
**/evaluate_density.py
**/evaluate_consistency.py
evaluate_density.py
evaluate_consistency.py

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Environments & Package Managers
.venv/
env/
venv/
ENV/
node_modules/

# OS & Windows Subsystem Metadata
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*:Zone.Identifier
*Zone.Identifier

# Log & Temporary Files
*.log
*.err
*.tmp
*.temp
slurm-*.out
slurm-*.err
unclos_*_*.log
unclos_*_*.err
mineru_*_*.log
mineru_*_*.err

# Environment & Secret API Keys (CRITICAL SECURITY)
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# Intermediate Checkpoint Caches
*translation_cache.json
**/*translation_cache.json

# Folder Pengujian Chunking Khusus (Universal Legal Chunking & Test Output)
pengujian_chunking/
5_pengujian_chunking_universal/

# Folder Pengujian Khusus Putusan Pidana (Isolasi Eksperimen Kasus Peradilan)
6_minirag_putusan_pidana/

indexing_hirarki/

# Plan & Panduan Internal Tracking
*PLAN*.md
*PANDUAN*.md
*KOMPARASI_ASLI*.md
**/PLAN*.md
**/PANDUAN*.md
**/KOMPARASI_ASLI*.md

# Isolasi isi versi disempurnakan (hanya track foldernya via .gitkeep)
7_indexing_regulasi_2lapis/2_graf_lapisan1_manual/2_versi_disempurnakan/*
!7_indexing_regulasi_2lapis/2_graf_lapisan1_manual/2_versi_disempurnakan/.gitkeep



