<node id="&quot;SISTEM PENEGAKAN HUKUM&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Mekanisme menindak pelanggaran hukum perikanan."&lt;SEP&gt;"Mekanisme untuk menjatuhkan sanksi kepada pelanggar peraturan perikanan."&lt;SEP&gt;"Proses untuk memastikan peraturan perikanan dipatuhi dan pelanggaran ditindak."&lt;SEP&gt;"Upaya menindak pelanggaran hukum di bidang perikanan."&lt;SEP&gt;"Proses penegakan hukum terhadap pelanggaran perikanan."&lt;SEP&gt;"Proses menjalankan hukum secara efektif dan adil."&lt;SEP&gt;"Mekanisme untuk menindak pelanggaran terhadap peraturan perikanan."&lt;SEP&gt;"Sarana untuk menjaga ketertiban dan keadilan dalam kegiatan perikanan."</data>
  <data key="d2">chunk-0ba9066a282211d5805bfe15bc0ce9ea</data>
</node>
