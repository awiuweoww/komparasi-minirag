</node>
<node id="&quot;PEMBIAYAAN&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Pendanaan atau pemberian kredit untuk suatu kegiatan."&lt;SEP&gt;"Penyediaan dana untuk mendukung kegiatan perikanan dan pelestarian sumber daya ikan."&lt;SEP&gt;"Penyediaan dana untuk mendukung kegiatan terkait sumber daya ikan."&lt;SEP&gt;"Sumber dana untuk mendukung kegiatan terkait pemanfaatan sumber daya ikan."&lt;SEP&gt;"Sumber dana yang digunakan untuk pembelian atau pembangunan kapal perikanan."&lt;SEP&gt;"Sumber dana untuk mendukung usaha perikanan."&lt;SEP&gt;"Sumber dana untuk menjalankan kegiatan pengawasan perikanan."&lt;SEP&gt;"Sumber dana untuk mendukung kegiatan konservasi."&lt;SEP&gt;"Sumber dana untuk mendukung usaha perikanan."&lt;SEP&gt;"Pengaturan tentang sumber dana untuk kegiatan pelabuhan."</data>
  <data key="d2">chunk-66c092ae4e25214ee5a9df3d16992739&lt;SEP&gt;chunk-0b90620398bd698c56737fcc306ff213&lt;SEP&gt;chunk-0eb5ca935b77357ee0e5a4d1bd028740&lt;SEP&gt;chunk-cc7f00e74487eb0250db1e39c19f6059&lt;SEP&gt;chunk-79ce8e3a8862a13c8b0016ee2e97d41b&lt;SEP&gt;chunk-3de1e85ddc12490ed72c06f8c751f649&lt;SEP&gt;chunk-8c996679ac11e38dfd7591051a607b38&lt;SEP&gt;chunk-fbb8144ebe035a79643776b8a3b4d6fd&lt;SEP&gt;chunk-31e8f682c7b0b804fb3a83dda696d056</data>
