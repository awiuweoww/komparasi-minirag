  <data key="d0">"KONSEP"</data>
  <data key="d1">"Aktivitas mengubah hasil tangkapan atau budidaya menjadi produk yang lebih bernilai."&lt;SEP&gt;"Kegiatan mengubah hasil tangkapan ikan menjadi produk yang lebih bernilai."&lt;SEP&gt;"Proses mengubah ikan mentah menjadi produk olahan seperti ikan kering, ikan asin, atau ikan kaleng."&lt;SEP&gt;"Proses mengubah ikan mentah menjadi produk olahan."&lt;SEP&gt;"Proses mengubah ikan mentah menjadi produk olahan."&lt;SEP&gt;"Proses mengubah ikan mentah menjadi produk yang lebih bernilai."&lt;SEP&gt;"Proses mengubah hasil tangkapan atau budidaya menjadi produk yang lebih bernilai."&lt;SEP&gt;"Proses mengubah hasil tangkapan atau budidaya ikan menjadi produk yang lebih bernilai."&lt;SEP&gt;"Proses mengubah hasil tangkapan ikan menjadi produk yang lebih bernilai."&lt;SEP&gt;"Proses mengubah hasil tangkapan menjadi produk olahan."&lt;SEP&gt;"Proses mengubah hasil perikanan mentah menjadi produk olahan yang lebih bernilai jual."&lt;SEP&gt;"Proses mengubah ikan atau hasil perikanan lainnya menjadi produk yang lebih bernilai."&lt;SEP&gt;"Proses mengubah hasil perikanan mentah menjadi produk olahan."&lt;SEP&gt;"Proses mengubah ikan mentah menjadi produk olahan yang lebih bernilai jual."&lt;SEP&gt;"Proses mengubah hasil tangkapan ikan menjadi produk yang lebih bernilai."&lt;SEP&gt;"Proses mengubah ikan menjadi produk olahan."&lt;SEP&gt;"Proses mengubah hasil perikanan menjadi produk yang lebih bernilai."&lt;SEP&gt;"Proses mengubah ikan menjadi produk olahan."&lt;SEP&gt;"Proses mengubah ikan menjadi produk yang lebih bernilai."&lt;SEP&gt;"Proses mengubah hasil tangkapan ikan menjadi produk yang lebih bernilai."&lt;SEP&gt;"Proses mengubah bahan mentah perikanan menjadi produk siap konsumsi."&lt;SEP&gt;"Proses mengubah hasil tangkapan atau budidaya menjadi produk olahan, seperti kerupuk ikan atau abon."&lt;SEP&gt;"Proses mengubah hasil tangkap ikan menjadi produk yang lebih bernilai."&lt;SEP&gt;"Proses mengubah ikan mentah menjadi produk olahan."&lt;SEP&gt;"Proses mengubah hasil tangkapan ikan menjadi produk yang lebih awet dan bervariasi."&lt;SEP&gt;"Proses mengubah hasil tangkapan atau budidaya menjadi produk yang lebih bernilai."&lt;SEP&gt;"Proses mengubah hasil tangkapan menjadi produk olahan."&lt;SEP&gt;"Proses mengubah hasil perikanan mentah menjadi produk yang lebih bernilai."&lt;SEP&gt;"Proses mengubah hasil tangkapan menjadi produk yang siap dikonsumsi."&lt;SEP&gt;"Proses mengubah ikan mentah menjadi produk yang siap dikonsumsi."&lt;SEP&gt;"Proses mengubah ikan atau hasil perikanan lainnya menjadi produk yang lebih bernilai."</data>
