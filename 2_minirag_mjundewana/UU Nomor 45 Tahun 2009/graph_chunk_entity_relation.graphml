<node id="&quot;PENDIDIKAN DAN PELATIHAN TEKNIS PERIKANAN&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Pendidikan formal dan pelatihan khusus di bidang perikanan."&lt;SEP&gt;"Syarat penuntut umum memiliki pendidikan dan pelatihan khusus di bidang perikanan."&lt;SEP&gt;"Syarat penuntut umum mengikuti pendidikan dan pelatihan di bidang perikanan."&lt;SEP&gt;"Penuntut umum harus memiliki pendidikan dan pelatihan di bidang perikanan."&lt;SEP&gt;"Persyaratan mengikuti pendidikan dan pelatihan khusus di bidang perikanan."&lt;SEP&gt;"Syarat penuntut umum yaitu telah mengikuti pelatihan di bidang perikanan."&lt;SEP&gt;"Penuntut umum harus mengikuti pendidikan dan pelatihan teknis di bidang perikanan."</data>
  <data key="d2">chunk-2f2a03813daba3438d0cd54f4b8e8cef</data>
</node>
<node id="&quot;PENYAMPAIAN BERKAS PERKARA&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Proses penyerahan berkas perkara dari penyidik ke penuntut umum."&lt;SEP&gt;"Proses penyerahan berkas perkara dari penyidik kepada penuntut umum."</data>
  <data key="d2">chunk-2f2a03813daba3438d0cd54f4b8e8cef</data>
