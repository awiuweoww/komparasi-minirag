</node>
<node id="&quot;DEMI HUKUM&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Berdasarkan ketentuan hukum yang berlaku."&lt;SEP&gt;"Sesuai dengan hukum yang berlaku."&lt;SEP&gt;"Sesuai dengan peraturan perundang-undangan yang berlaku."</data>
  <data key="d2">chunk-41536f4ea22764b750d1aae85eea7cf8</data>
</node>
<node id="&quot;SYARAT&quot;">
  <data key="d0">"STRUKTUR"</data>
  <data key="d1">"Ketentuan yang harus dipenuhi untuk dapat melanjutkan tindakan hukum."&lt;SEP&gt;"Persyaratan yang harus dipenuhi."&lt;SEP&gt;"Persyaratan yang harus dipenuhi."&lt;SEP&gt;"Persyaratan yang harus dipenuhi."</data>
  <data key="d2">chunk-41536f4ea22764b750d1aae85eea7cf8&lt;SEP&gt;chunk-a5827b7d9169285a008ba1356a881f85&lt;SEP&gt;chunk-79ce8e3a8862a13c8b0016ee2e97d41b&lt;SEP&gt;chunk-c4c40482bb5b13bed741ed6a258e7093</data>
</node>
<node id="&quot;BERKAS&quot;">
  <data key="d0">"KONSEP"</data>
