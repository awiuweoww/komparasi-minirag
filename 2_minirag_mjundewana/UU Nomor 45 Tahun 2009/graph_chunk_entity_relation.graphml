<node id="&quot;TAHAP PENYIDIKAN&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Proses hukum yang dilakukan setelah penangkapan dan sebelum penuntutan."&lt;SEP&gt;"Tahap proses hukum yang dilakukan untuk mencari dan mengumpulkan bukti tindak pidana."&lt;SEP&gt;"Tahap proses hukum setelah penangkapan yang bertujuan untuk mengumpulkan bukti."&lt;SEP&gt;"Proses pengumpulan bukti蝎子 dan pemeriksaan terkait tindak pidana."</data>
  <data key="d2">chunk-41536f4ea22764b750d1aae85eea7cf8&lt;SEP&gt;chunk-64bbdc39c409427b09c98bf83549ed11</data>
</node>
<node id="&quot;TAHAP PENUNTUTAN&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Proses pengajuan tuntutan pidana di pengadilan."&lt;SEP&gt;"Tahap proses hukum setelah tahap penyidikan, dimana penuntut umum mengajukan tuntutan."&lt;SEP&gt;"Tahap proses hukum yang dilakukan untuk menuntut pelaku tindak pidana."</data>
  <data key="d2">chunk-41536f4ea22764b750d1aae85eea7cf8&lt;SEP&gt;chunk-64bbdc39c409427b09c98bf83549ed11</data>
</node>
<node id="&quot;PERAMPASAN BARANG BUKTI&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Proses pengambilan barang bukti secara permanen."&lt;SEP&gt;"Tindakan negara mengambil barang bukti untuk dimiliki secara permanen."&lt;SEP&gt;"Tindakan mengambil barang bukti dari pemiliknya untuk kepentingan negara."&lt;SEP&gt;"Tindakan mengambil barang bukti untuk negara."&lt;SEP&gt;"Tindakan mengambil alih kepemilikan barang bukti dari pelaku atau pihak lain."</data>
  <data key="d2">chunk-64bbdc39c409427b09c98bf83549ed11</data>
</node>
<node id="&quot;PEMUSNAHAN BARANG BUKTI&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Proses menghilangkan barang bukti secara fisik."&lt;SEP&gt;"Tindakan menghancurkan barang bukti setelah persetujuan pengadilan."&lt;SEP&gt;"Tindakan menghancurkan barang bukti setelah proses hukum selesai."&lt;SEP&gt;"Proses penghancuran barang bukti setelah proses hukum selesai."&lt;SEP&gt;"Tindakan menghancurkan barang bukti."&lt;SEP&gt;"Proses menghilangkan barang bukti secara permanen."</data>
