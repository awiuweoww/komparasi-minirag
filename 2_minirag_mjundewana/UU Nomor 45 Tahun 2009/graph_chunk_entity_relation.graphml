  <data key="d0">"KONSEP"</data>
  <data key="d1">"Langkah pengambilalihan barang bukti dari pelaku tindak pidana."&lt;SEP&gt;"Proses pengambilalihan barang bukti oleh petugas penyidik."&lt;SEP&gt;"Tindakan hukum mengambil alih barang bukti."&lt;SEP&gt;"Tindakan mengambil alih aset yang terkait dengan pelanggaran perikanan."&lt;SEP&gt;"Tindakan mengambil alih barang bukti pelanggaran."&lt;SEP&gt;"Tindakan mengambil alih kapal atau barang bukti pelanggaran oleh pihak berwenang."&lt;SEP&gt;"Tindakan mengambil barang bukti dari pelaku tindak pidana."&lt;SEP&gt;"Tindakan pengambilan paksa atas barang bukti pelanggaran."&lt;SEP&gt;"Tindakan pengambilalihan barang bukti oleh penyidik."&lt;SEP&gt;"Tindakan mengambil alih barang atau kapal yang terkait dengan pelanggaran."&lt;SEP&gt;"Tindakan mengambil barang bukti dari kapal yang melanggar."&lt;SEP&gt;"Tindakan untuk mengamankan barang bukti dalam proses hukum."&lt;SEP&gt;"Tindakan pengamanan barang bukti oleh penyidik."&lt;SEP&gt;"Tindakan menyita barang bukti dari pelaku tindak pidana."&lt;SEP&gt;"Tindakan pengambilalihan barang bukti oleh penyidik."&lt;SEP&gt;"Tindakan sementara mengambil alih barang bukti atau kapal."&lt;SEP&gt;"Tindakan mengambil alih suatu barang atau aset dari seseorang."&lt;SEP&gt;"Tindakan mengambil alih barang bukti dari pelaku tindak pidana."&lt;SEP&gt;"Tindakan mengambil alih kapal atau hasil tangkapan sebagai barang bukti."&lt;SEP&gt;"Tindakan mengambil alih kapal atau hasil tangkapan secara paksa."&lt;SEP&gt;"Proses pengambilan barang bukti dari pelaku tindak pidana."&lt;SEP&gt;"Tindakan mengambil alih barang bukti dari tangan pelaku."&lt;SEP&gt;"Tindakan hukum untuk mengambil sementara atau permanen barang bukti."&lt;SEP&gt;"Tindakan mengambil alih kapal atau hasil tangkapan yang melanggar hukum."&lt;SEP&gt;"Tindakan pengambilalihan barang oleh pihak berwenang."&lt;SEP&gt;"Tindakan mengambil alih kapal, tangkapan, atau peralatan yang melanggar peraturan."&lt;SEP&gt;"Tindakan mengambil barang atau kapal milik pelaku pelanggaran."&lt;SEP&gt;"Tindakan sementara menyita benda dari seseorang karena diduga terkait dengan tindak pidana."&lt;SEP&gt;"Tindakan mengambil alih barang bukti dari pelaku pelanggaran."&lt;SEP&gt;"Tindakan mengambil alih kapal, alat penangkapan ikan, dan hasil tangkapan yang digunakan dalam pelanggaran."&lt;SEP&gt;"Tindakan hukum untuk mengambil sementara atau permanen barang dari seseorang."&lt;SEP&gt;"Tindakan mengambil alih kapal dan/atau hasil tangkapan yang melanggar hukum."&lt;SEP&gt;"Tindakan pengambilalihan barang bukti dari pelaku tindak pidana."&lt;SEP&gt;"Proses pengambilan barang dari seseorang atau tempat oleh pejabat yang berwenang."&lt;SEP&gt;"Tindakan hukum mengambil alih barang bukti yang terkait dengan tindak pidana perikanan."&lt;SEP&gt;"Tindakan mengambil alih barang bukti dari tersangka atau saksi."&lt;SEP&gt;"Tindakan hukum untuk mengambil barang bukti dari tangan pelaku."&lt;SEP&gt;"Tindakan mengambil alih barang bukti oleh penyidik."&lt;SEP&gt;"Tindakan mengambil alih kapal atau barang hasil tangkapan yang melanggar peraturan."&lt;SEP&gt;"Tindakan mengambil alih kapal dan barang bukti pelanggaran."&lt;SEP&gt;"Tindakan mengambil alih kapal perikanan sebagai barang bukti."&lt;SEP&gt;"Tindakan hukum untuk mengambil barang bukti."&lt;SEP&gt;"Tindakan menyita barang bukti yang digunakan atau hasil dari tindak pidana."&lt;SEP&gt;"Tindakan hukum mengambil barang bukti dari pelaku tindak pidana."&lt;SEP&gt;"Tindakan sementara yang dilakukan aparat penegak hukum untuk mengamankan barang bukti."&lt;SEP&gt;"Tindakan menyita barang bukti atau kapal yang terlibat dalam tindak pidana perikanan."&lt;SEP&gt;"Tindakan pengambilalihan barang bukti terkait pelanggaran perikanan."&lt;SEP&gt;"Tindakan sementara mengambil alih barang dari seseorang dalam proses penyidikan."&lt;SEP&gt;"Proses mengambil barang bukti dari tersangka atau pihak terkait."&lt;SEP&gt;"Tindakan hukum untuk mengambil sementara atau permanen suatu benda sebagai bukti."&lt;SEP&gt;"Tindakan mengambil alih barang bukti dari seseorang atau sesuatu."&lt;SEP&gt;"Tindakan mengambil alih kapal dan hasil tangkapan secara paksa."&lt;SEP&gt;"Tindakan sementara mengambil alih barang bukti dari pelaku pelanggaran."</data>
