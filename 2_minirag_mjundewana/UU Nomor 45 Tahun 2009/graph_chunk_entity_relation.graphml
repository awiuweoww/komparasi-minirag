  <data key="d0">"KONSEP"</data>
  <data key="d1">"Tindakan menjaga dan melindungi sumber daya ikan agar tetap lestari."&lt;SEP&gt;"Tindakan menjaga kelestarian alam dan sumber daya."&lt;SEP&gt;"Upaya menjaga keberlangsungan sumber daya perikanan untuk generasi mendatang."&lt;SEP&gt;"Upaya untuk menjaga keberadaan sumber daya perikanan agar tetap ada di masa depan."&lt;SEP&gt;"Upaya untuk menjaga kelestarian lingkungan perairan dan ekosistemnya."&lt;SEP&gt;"Upaya menjaga kelestarian sumber daya ikan agar tetap ada untuk generasi mendatang."&lt;SEP&gt;"Upaya menjaga kelestarian sesuatu agar tetap ada dan bermanfaat."&lt;SEP&gt;"Upaya untuk menjaga dan melestarikan sumber daya alam, termasuk plasma nutfah ikan."&lt;SEP&gt;"Upaya untuk menjaga kelestarian sumber daya ikan."&lt;SEP&gt;"Upaya menjaga kelestarian lingkungan perairan dan sumber daya perikanan."&lt;SEP&gt;"Upaya untuk menjaga kelestarian sumber daya ikan."&lt;SEP&gt;"Upaya menjaga keutuhan dan keberadaan suatu hal."&lt;SEP&gt;"Upaya menjaga keberadaan sumber daya perikanan agar tetap ada di masa depan."&lt;SEP&gt;"Upaya menjaga keutuhan sumber daya perikanan agar tetap lestari."&lt;SEP&gt;"Upaya menjaga keutuhan sumber daya perairan."&lt;SEP&gt;"Upaya menjaga keaslian dan keberlanjutan lingkungan."&lt;SEP&gt;"Upaya untuk menjaga keanekaragaman genetik ikan."</data>
