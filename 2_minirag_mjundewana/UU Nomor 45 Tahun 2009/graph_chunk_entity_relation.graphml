<node id="&quot;PENGEMBANGAN INFRASTRUKTUR PERIKANAN&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Pembangunan dan peningkatan fasilitas pendukung kegiatan perikanan."&lt;SEP&gt;"Pembangunan fasilitas penunjang kegiatan perikanan."&lt;SEP&gt;"Pembangunan fasilitas seperti pelabuhan, cold storage, dan jalan akses untuk mendukung kegiatan perikanan."&lt;SEP&gt;"Peningkatan fasilitas pendukung kegiatan perikanan, seperti jalan, jembatan, dan listrik."&lt;SEP&gt;"Proses peningkatan fasilitas dan peralatan di sektor perikanan."&lt;SEP&gt;"Pembangunan fasilitas pendukung kegiatan perikanan, seperti pelabuhan dan jalan akses."&lt;SEP&gt;"Pembangunan fasilitas yang mendukung kegiatan perikanan."&lt;SEP&gt;"Peningkatan fasilitas dan sarana penunjang kegiatan perikanan."&lt;SEP&gt;"Pembangunan fasilitas pelabuhan, cold storage, dan infrastruktur pendukung lainnya."&lt;SEP&gt;"Peningkatan fasilitas dan sarana pendukung kegiatan perikanan."&lt;SEP&gt;"Pembangunan fasilitas pendukung usaha perikanan."&lt;SEP&gt;"Pembangunan fasilitas dan sarana prasarana yang mendukung kegiatan perikanan."&lt;SEP&gt;"Peningkatan fasilitas dan sarana penunjang kegiatan perikanan, seperti pelabuhan, pabrik pengolahan, dan jalan akses."&lt;SEP&gt;"Peningkatan fasilitas dan sarana untuk mendukung kegiatan perikanan."</data>
  <data key="d2">chunk-66c092ae4e25214ee5a9df3d16992739&lt;SEP&gt;chunk-8cadef05774bb739846ce86037de9d52&lt;SEP&gt;chunk-218441f5ebd44aad0f511dec54681140&lt;SEP&gt;chunk-79ce8e3a8862a13c8b0016ee2e97d41b&lt;SEP&gt;chunk-b99c422498d37d308ef747f72fa8a528&lt;SEP&gt;chunk-125df9d1d7cffea11ffab072d44e2743&lt;SEP&gt;chunk-7c81ea4cabbe2f1cac2c8013b7d1be01&lt;SEP&gt;chunk-3e74addd220c50c1ce355ec380bb2f2b&lt;SEP&gt;chunk-c4c40482bb5b13bed741ed6a258e7093&lt;SEP&gt;chunk-d4eca31309140c3d66e35abc5ffb16b4</data>
