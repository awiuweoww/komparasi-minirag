<node id="&quot;KEPENTINGAN KEBUDAYAAN&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Alasan budaya untuk menjaga keberlanjutan sumber daya ikan."&lt;SEP&gt;"Alasan pelindungan ikan terkait tradisi dan nilai budaya."&lt;SEP&gt;"Alasan penetapan perlindungan dan konservasi perairan."&lt;SEP&gt;"Penggunaan sumber daya ikan dalam tradisi dan adat istiadat."&lt;SEP&gt;"Alasan perlindungan ikan dan kawasan konservasi terkait dengan nilai-nilai budaya."&lt;SEP&gt;"Tujuan perlindungan ikan dan kawasan konservasi untuk menjaga warisan budaya."&lt;SEP&gt;"Tujuan konservasi untuk menjaga warisan budaya."&lt;SEP&gt;"Nilai-nilai tradisional yang berkaitan dengan ikan."&lt;SEP&gt;"Alasan untuk melindungi dan melestarikan ikan dan ekosistemnya demi melestarikan budaya masyarakat."&lt;SEP&gt;"Tujuan pelestarian untuk menjaga warisan budaya terkait ikan."</data>
  <data key="d2">chunk-8c996679ac11e38dfd7591051a607b38</data>
</node>
<node id="&quot;KEPENTINGAN PARIWISATA&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Alasan pelindungan ikan terkait daya tarik wisata."&lt;SEP&gt;"Alasan penetapan perlindungan dan konservasi perairan."&lt;SEP&gt;"Pemanfaatan sumber daya ikan untuk menarik wisatawan."&lt;SEP&gt;"Alasan perlindungan ikan dan kawasan konservasi untuk menarik wisatawan."&lt;SEP&gt;"Manfaat ekonomi dari keberadaan ikan dan perairan."&lt;SEP&gt;"Tujuan perlindungan ikan dan kawasan konservasi untuk menarik wisatawan."&lt;SEP&gt;"Tujuan konservasi untuk mendukung industri pariwisata."&lt;SEP&gt;"Potensi wisata yang berkaitan dengan sumber daya ikan."&lt;SEP&gt;"Daya tarik wisata yang terkait dengan keberadaan ikan dan lingkungan perairan."&lt;SEP&gt;"Alasan untuk menjaga sumber daya ikan dan lingkungannya demi menarik wisatawan."&lt;SEP&gt;"Alasan untuk melindungi sumber daya ikan untuk kepentingan pariwisata."&lt;SEP&gt;"Alasan untuk melindungi dan melestarikan ikan dan ekosistemnya demi menarik wisatawan."&lt;SEP&gt;"Tujuan pelestarian untuk mendukung pengembangan sektor pariwisata."</data>
  <data key="d2">chunk-8c996679ac11e38dfd7591051a607b38</data>
</node>
