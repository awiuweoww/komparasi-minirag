<node id="&quot;PENGEMBANGAN SUMBER DAYA MANUSIA&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Meningkatkan keterampilan dan pengetahuan pelaku perikanan."&lt;SEP&gt;"Upaya meningkatkan kualitas tenaga kerja di bidang perikanan."&lt;SEP&gt;"Upaya meningkatkan pengetahuan dan keterampilan pelaku usaha perikanan."&lt;SEP&gt;"Upaya meningkatkan pengetahuan dan keterampilan pekerja di bidang perikanan."&lt;SEP&gt;"Upaya peningkatan kualitas sumber daya manusia di sektor perikanan."&lt;SEP&gt;"Upaya meningkatkan kualitas tenaga kerja di sektor perikanan."&lt;SEP&gt;"Upaya meningkatkan pengetahuan dan keterampilan tenaga kerja di bidang perikanan."&lt;SEP&gt;"Upaya peningkatan pengetahuan dan keterampilan di bidang perikanan."&lt;SEP&gt;"Upaya meningkatkan keterampilan dan pengetahuan nelayan dan pembudidaya ikan."</data>
  <data key="d2">chunk-3de1e85ddc12490ed72c06f8c751f649&lt;SEP&gt;chunk-3e74addd220c50c1ce355ec380bb2f2b&lt;SEP&gt;chunk-8c996679ac11e38dfd7591051a607b38&lt;SEP&gt;chunk-4d638331ebecea1b50f793c74699459c&lt;SEP&gt;chunk-31e8f682c7b0b804fb3a83dda696d056</data>
