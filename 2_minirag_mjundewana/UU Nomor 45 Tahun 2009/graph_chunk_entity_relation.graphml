  <data key="d1">"Kewajiban dalam pengawasan perlindungan lingkungan maritim."&lt;SEP&gt;"Kewajiban mengawasi pelaksanaan perlindungan lingkungan maritim."&lt;SEP&gt;"Upaya menjaga kebersihan laut."&lt;SEP&gt;"Upaya menjaga kelestarian lingkungan laut."&lt;SEP&gt;"Upaya menjaga kelestarian lingkungan laut."&lt;SEP&gt;"Upaya menjaga kelestarian lingkungan laut di sekitar pelabuhan perikanan."&lt;SEP&gt;"Upaya menjaga kelestarian lingkungan laut."&lt;SEP&gt;"Upaya untuk menjaga kelestarian lingkungan laut."&lt;SEP&gt;"Upaya menjaga kelestarian lingkungan laut."&lt;SEP&gt;"Upaya menjaga kelestarian lingkungan laut di sekitar pelabuhan perikanan."&lt;SEP&gt;"Upaya menjaga kelestarian lingkungan laut."&lt;SEP&gt;"Upaya menjaga kelestarian lingkungan laut."&lt;SEP&gt;"Kewajiban untuk mengawasi pelaksanaan perlindungan lingkungan maritim."&lt;SEP&gt;"Upaya menjaga kelestarian dan kebersihan lingkungan laut."&lt;SEP&gt;"Upaya menjaga kelestarian lingkungan laut."&lt;SEP&gt;"Kewajiban mengawasi pelaksanaan perlindungan lingkungan maritim."&lt;SEP&gt;"Kewajiban terkait pengawasan pelaksanaan perlindungan lingkungan maritim."&lt;SEP&gt;"Upaya menjaga kelestarian lingkungan laut."&lt;SEP&gt;"Upaya menjaga kelestarian lingkungan laut."&lt;SEP&gt;"Kewajiban untuk mengawasi perlindungan lingkungan maritim."&lt;SEP&gt;"Upaya untuk menjaga kelestarian lingkungan laut."</data>
