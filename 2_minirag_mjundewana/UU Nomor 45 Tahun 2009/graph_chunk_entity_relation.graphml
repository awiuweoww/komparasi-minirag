<node id="&quot;SERTIFIKASI&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Bukti atau jaminan bahwa produk atau proses telah memenuhi standar tertentu."&lt;SEP&gt;"Penilaian dan pengakuan atas kualitas dan keamanan produk perikanan."&lt;SEP&gt;"Proses pemberian jaminan kualitas terhadap produk ikan."&lt;SEP&gt;"Proses pengakuan kualitas produk atau proses produksi."&lt;SEP&gt;"Proses pemberian jaminan kualitas pada produk perikanan."&lt;SEP&gt;"Proses pemberian tanda atau bukti yang menyatakan bahwa suatu produk atau kegiatan memenuhi standar tertentu."&lt;SEP&gt;"Proses pemberian bukti kesesuaian dengan standar tertentu."&lt;SEP&gt;"Pengakuan resmi terhadap kualitas dan keamanan produk perikanan."&lt;SEP&gt;"Penilaian dan pengakuan resmi terhadap kualitas atau keberlanjutan kegiatan budidaya ikan."&lt;SEP&gt;"Bukti bahwa produk perikanan telah memenuhi standar tertentu."&lt;SEP&gt;"Proses memberikan jaminan kualitas terhadap produk perikanan."&lt;SEP&gt;"Bukti pemenuhan standar tertentu oleh produk perikanan."&lt;SEP&gt;"Proses pemberian bukti kompetensi."&lt;SEP&gt;"Proses verifikasi dan pengakuan atas kualitas produk atau proses budidaya."&lt;SEP&gt;"Pengakuan atas pemenuhan standar mutu dan keamanan."&lt;SEP&gt;"Proses pengakuan kompetensi profesional."</data>
  <data key="d2">chunk-a5827b7d9169285a008ba1356a881f85&lt;SEP&gt;chunk-3de1e85ddc12490ed72c06f8c751f649&lt;SEP&gt;chunk-b99c422498d37d308ef747f72fa8a528&lt;SEP&gt;chunk-7c81ea4cabbe2f1cac2c8013b7d1be01&lt;SEP&gt;chunk-2a9de1547a5ac850d0203f29263e8201&lt;SEP&gt;chunk-31e8f682c7b0b804fb3a83dda696d056</data>
</node>
<node id="&quot;HASIL LAUT&quot;">
