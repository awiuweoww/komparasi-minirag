  <data key="d1">"Upaya meningkatkan dan memajukan sektor perikanan."&lt;SEP&gt;"Upaya meningkatkan nilai tambah dari kegiatan perikanan."&lt;SEP&gt;"Upaya meningkatkan skala dan nilai tambah industri perikanan."&lt;SEP&gt;"Upaya untuk meningkatkan daya saing sektor perikanan."&lt;SEP&gt;"Upaya untuk meningkatkan pertumbuhan industri perikanan."&lt;SEP&gt;"Upaya meningkatkan nilai tambah dari kegiatan perikanan."&lt;SEP&gt;"Upaya meningkatkan nilai tambah dan daya saing sektor perikanan."&lt;SEP&gt;"Upaya meningkatkan nilai tambah dari kegiatan perikanan."&lt;SEP&gt;"Upaya meningkatkan nilai tambah sektor perikanan."&lt;SEP&gt;"Upaya meningkatkan nilai tambah sektor perikanan."&lt;SEP&gt;"Upaya untuk meningkatkan pertumbuhan dan efisiensi sektor perikanan."&lt;SEP&gt;"Upaya meningkatkan daya saing dan pertumbuhan sektor perikanan."&lt;SEP&gt;"Upaya meningkatkan skala dan kualitas industri perikanan."&lt;SEP&gt;"Upaya untuk meningkatkan pertumbuhan dan efisiensi sektor perikanan."&lt;SEP&gt;"Upaya meningkatkan nilai tambah dari sektor perikanan."&lt;SEP&gt;"Upaya meningkatkan nilai tambah dan daya saing sektor perikanan."&lt;SEP&gt;"Upaya peningkatan kualitas dan kuantitas produksi perikanan."&lt;SEP&gt;"Upaya untuk meningkatkan skala dan efisiensi sektor perikanan."&lt;SEP&gt;"Upaya untuk mengembangkan sektor perikanan menjadi industri yang lebih maju."</data>
