<node id="&quot;PEMANFAATAN&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Kegiatan menggunakan sumber daya ikan untuk kepentingan manusia."&lt;SEP&gt;"Penggunaan sumber daya ikan secara bertanggung jawab."&lt;SEP&gt;"Tindakan penggunaan sumber daya ikan untuk memenuhi kebutuhan."&lt;SEP&gt;"Penggunaan sumber daya ikan untuk kepentingan manusia."&lt;SEP&gt;"Penggunaan sumber daya untuk kepentingan manusia."&lt;SEP&gt;"Pemberdayaan sumber daya ikan untuk kesejahteraan."&lt;SEP&gt;"Tindakan menggunakan atau mengambil manfaat dari sesuatu."&lt;SEP&gt;"Penggunaan sumber daya ikan untuk berbagai tujuan."&lt;SEP&gt;"Penggunaan sumber daya untuk mencapai tujuan tertentu."&lt;SEP&gt;"Penggunaan sumber daya untuk kepentingan manusia."&lt;SEP&gt;"Tindakan mengambil manfaat atau menggunakan sesuatu."&lt;SEP&gt;"Tindakan menggunakan sumber daya ikan untuk kepentingan ekonomi atau sosial."&lt;SEP&gt;"Tindakan menggunakan sumber daya ikan untuk kepentingan manusia."&lt;SEP&gt;"Penggunaan sumber daya untuk kepentingan ekonomi."&lt;SEP&gt;"Menggunakan sumber daya untuk kepentingan masyarakat."&lt;SEP&gt;"Penggunaan sumber daya perikanan untuk kepentingan ekonomi dan kesejahteraan."&lt;SEP&gt;"Penggunaan atau eksploitasi sumber daya ikan untuk kepentingan manusia."&lt;SEP&gt;"Penggunaan atau eksploitasi sumber daya."&lt;SEP&gt;"Tindakan menggunakan sumber daya untuk kepentingan manusia."&lt;SEP&gt;"Penggunaan sesuatu untuk tujuan tertentu."</data>
