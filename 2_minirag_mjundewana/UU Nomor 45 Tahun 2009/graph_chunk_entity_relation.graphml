  <data key="d0">"STRUKTUR"</data>
  <data key="d1">"Batas waktu 10 hari bagi penuntut umum untuk menyatakan kelengkapan berkas."&lt;SEP&gt;"Batas waktu penuntut umum menyatakan hasil penyidikan lengkap."&lt;SEP&gt;"Batas waktu penuntut umum menyatakan hasil penyidikan lengkap."&lt;SEP&gt;"Batas waktu penuntut umum menyatakan hasil penyidikan lengkap."&lt;SEP&gt;"Batas waktu penuntut umum menyatakan hasil penyidikan lengkap."&lt;SEP&gt;"Jangka waktu perpanjangan penahanan tersangka oleh penuntut umum."&lt;SEP&gt;"Jangka waktu yang ditetapkan dalam KUHAP."&lt;SEP&gt;"Jangka waktu maksimal bagi penuntut umum untuk menyatakan hasil penyidikan lengkap."&lt;SEP&gt;"Jangka waktu maksimal bagi penuntut umum untuk menyatakan hasil penyidikan lengkap."&lt;SEP&gt;"Jangka waktu perpanjangan tahanan."&lt;SEP&gt;"Jangka waktu maksimum bagi penuntut umum untuk menyatakan hasil penyidikan lengkap."&lt;SEP&gt;"Jangka waktu penahanan lanjutan yang diperbolehkan untuk kepentingan penuntutan."&lt;SEP&gt;"Jangka waktu maksimal penuntut umum menyatakan berkas lengkap dan melimpahkan perkara."&lt;SEP&gt;"Batas waktu penuntutвано umum untuk menyatakan berkas lengkap."</data>
