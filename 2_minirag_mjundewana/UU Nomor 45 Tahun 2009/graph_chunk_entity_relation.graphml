<node id="&quot;AYAT (6)&quot;">
  <data key="d0">"STRUKTUR"</data>
  <data key="d1">"Ayat dalam teks."&lt;SEP&gt;"Ayat keenam yang mengatur pelaksanaan ketentuan lebih lanjut."&lt;SEP&gt;"Ayat yang memberikan definisi 'jenis ikan'."&lt;SEP&gt;"Bagian dari Pasal yang mendefinisikan 'jenis ikan'."&lt;SEP&gt;"Bagian dari pasal yang mengatur tentang penahanan oleh penuntut umum."&lt;SEP&gt;"Bagian dari Pasal yang menjelaskan definisi jenis ikan."&lt;SEP&gt;"Bagian dari pasal yang menjelaskan definisi 'jenis ikan'."&lt;SEP&gt;"Bagian dari pasal yang menjelaskan definisi 'jenis ikan'."&lt;SEP&gt;"Bagian dari suatu pasal dalam peraturan perundang-undangan."&lt;SEP&gt;"Ayat yang menjelaskan definisi dari jenis ikan."&lt;SEP&gt;"Ayat yang menjelaskan definisi 'jenis ikan'."&lt;SEP&gt;"Ayat yang menjelaskan definisi jenis ikan."&lt;SEP&gt;"Ayat yang tidak memiliki penjelasan lebih lanjut."&lt;SEP&gt;"Ayat yang mendefinisikan berbagai jenis ikan."&lt;SEP&gt;"Bagian dari pasal yang menjelaskan detail yang tidak perlu dijelaskan lebih lanjut."&lt;SEP&gt;"Ayat yang memberikan definisi 'jenis ikan'."&lt;SEP&gt;"Ayat yang menjelaskan definisi 'jenis ikan'."&lt;SEP&gt;"Bagian dari pasal yang berisi ketentuan lebih lanjut."&lt;SEP&gt;"Bagian dari pasal yang memberikan penjelasan atau detail."&lt;SEP&gt;"Ayat yang menjelaskan definisi 'jenis ikan'."&lt;SEP&gt;"Poin yang terkait dengan penafsiran atau penjelasan suatu pasal atau peraturan."&lt;SEP&gt;"Ayat keenam dari Pasal 23, yang menyatakan 'Cukup jelas'."&lt;SEP&gt;"Ayat yang menjelaskan definisi jenis ikan."&lt;SEP&gt;"Bagian dari pasal yang menjelaskan suatu ketentuan."</data>
  <data key="d2">chunk-64bbdc39c409427b09c98bf83549ed11&lt;SEP&gt;chunk-db0247a5c2605b3662d379557c9a93fd&lt;SEP&gt;chunk-b604288d9f521c583a407d11f52879a0&lt;SEP&gt;chunk-a5827b7d9169285a008ba1356a881f85&lt;SEP&gt;chunk-c4c40482bb5b13bed741ed6a258e7093</data>
</node>
