<node id="&quot;PETUNJUK KELENGKAPAN BERKAS PERKARA&quot;">
  <data key="d0">"KEWAJIBAN"</data>
  <data key="d1">"Jika berkas perkara tidak lengkap, penuntut umum harus memberikan petunjuk kepada penyidik."&lt;SEP&gt;"Petunjuk yang harus diberikan penuntut umum jika berkas perkara belum lengkap."</data>
  <data key="d2">chunk-2f2a03813daba3438d0cd54f4b8e8cef</data>
</node>
<node id="&quot;WAKTU PENYAMPAIAN KEMBALI BERKAS PERKARA&quot;">
