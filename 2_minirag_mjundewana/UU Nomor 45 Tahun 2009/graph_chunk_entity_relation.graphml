  <data key="d0">"KONSEP"</data>
  <data key="d1">"Bentuk kerugian yang ditanggung negara akibat praktik ilegal di bidang perikanan."&lt;SEP&gt;"Hilangnya uang atau aset negara akibat tindak pidana."&lt;SEP&gt;"Kehilangan uang atau aset milik negara akibat tindak pidana perikanan."&lt;SEP&gt;"Kerugian yang diderita negara akibat tindak pidana."&lt;SEP&gt;"Kerugian yang dialami negara akibat tindakan pelanggaran hukum."&lt;SEP&gt;"Kerugian yang dialami negara akibat tindak pidana."&lt;SEP&gt;"Kehilangan pendapatan negara akibat pelanggaran perikanan."</data>
