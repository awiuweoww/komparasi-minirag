  <data key="d0">"KONSEP"</data>
  <data key="d1">"Pengaturan dan perlindungan wilayah pesisir yang terkait dengan perikanan."&lt;SEP&gt;"Upaya mengatur kegiatan di wilayah pesisir."&lt;SEP&gt;"Upaya menjaga keseimbangan ekosistem di wilayah pesisir yang terkait dengan perikanan."&lt;SEP&gt;"Upaya pengelolaan sumber daya di wilayah pesisir yang terintegrasi."&lt;SEP&gt;"Upaya untuk mengatur pemanfaatan sumber daya perikanan di wilayah pesisir."&lt;SEP&gt;"Upaya untuk menjaga keseimbangan ekosistem pesisir dan sumber daya perikanan."&lt;SEP&gt;"Upaya menjaga keseimbangan lingkungan dan memaksimalkan pemanfaatan sumber daya di wilayah pesisir."&lt;SEP&gt;"Upaya menjaga keseimbangan ekosistem dan sumber daya di wilayah pesisir."&lt;SEP&gt;"Upaya mengatur dan melindungi wilayah pesisir."&lt;SEP&gt;"Upaya menjaga keseimbangan antara pemanfaatan dan perlindungan lingkungan pesisir."&lt;SEP&gt;"Upaya mengatur dan menjaga wilayah pesisir yang penting bagi perikanan."&lt;SEP&gt;"Upaya menjaga keseimbangan ekosistem pesisir."&lt;SEP&gt;"Upaya melindungi dan mengelola kawasan pesisir."&lt;SEP&gt;"Upaya menjaga keseimbangan antara pemanfaatan dan pelestarian wilayah pesisir."&lt;SEP&gt;"Upaya menjaga keseimbangan ekosistem dan memaksimalkan pemanfaatan sumber daya di wilayah pesisir."&lt;SEP&gt;"Upaya menjaga keseimbangan antara pemanfaatan sumber daya dan pelestarian lingkungan pesisir."</data>
  <data key="d2">chunk-c2d883c1ca5fb776df88d3c531d0fc56&lt;SEP&gt;chunk-79ce8e3a8862a13c8b0016ee2e97d41b&lt;SEP&gt;chunk-b99c422498d37d308ef747f72fa8a528&lt;SEP&gt;chunk-aabc95cfe06d35c9dc9f8fdbb5b92d91&lt;SEP&gt;chunk-7c81ea4cabbe2f1cac2c8013b7d1be01&lt;SEP&gt;chunk-3e74addd220c50c1ce355ec380bb2f2b&lt;SEP&gt;chunk-d4eca31309140c3d66e35abc5ffb16b4&lt;SEP&gt;chunk-0ba9066a282211d5805bfe15bc0ce9ea</data>
