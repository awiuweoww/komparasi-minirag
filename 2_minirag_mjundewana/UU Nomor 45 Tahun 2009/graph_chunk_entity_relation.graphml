  <data key="d0">"KONSEP"</data>
  <data key="d1">"Proses mengembalikan seseorang ke negara asalnya."&lt;SEP&gt;"Tindakan mengembalikan orang asing ke negaranya."&lt;SEP&gt;"Tindakan mengembalikan orang asing ke negaranya."&lt;SEP&gt;"Tindakan mengembalikan seseorang ke negara asalnya."&lt;SEP&gt;"Tindakan mengembalikan seseorang ke negara asalnya."&lt;SEP&gt;"Tindakan mengembalikan seseorang ke negaranya asal."&lt;SEP&gt;"Proses mengembalikan seseorang ke negaranya."&lt;SEP&gt;"Tindakan mengembalikan orang ke negara asalnya."</data>
  <data key="d2">chunk-447ad19ce23b0cb808b8e5e7dc0771c0</data>
</node>
