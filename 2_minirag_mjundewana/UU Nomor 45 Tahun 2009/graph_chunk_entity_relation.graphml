  <data key="d2">chunk-41536f4ea22764b750d1aae85eea7cf8</data>
</node>
<node id="&quot;PERPANJANGAN WAKTU PENAHANAN&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Pemberian waktu tambahan untuk melakukan penahanan tersangka."&lt;SEP&gt;"Pemberian waktu tambahan untuk penahanan tersangka."</data>
