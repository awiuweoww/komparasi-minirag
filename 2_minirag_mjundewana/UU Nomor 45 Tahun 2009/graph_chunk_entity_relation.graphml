  <data key="d2">chunk-41536f4ea22764b750d1aae85eea7cf8</data>
</node>
<node id="&quot;TINDAK PIDANA RINGAN&quot;">
  <data key="d0">"KONSEP"</data>
  <data key="d1">"Pelanggaran hukum dengan ancaman hukuman yang lebih ringan."&lt;SEP&gt;"Pelanggaran perikanan dengan ancaman hukuman yang relatif ringan."&lt;SEP&gt;"Pelanggaran perikanan yang memiliki ancaman hukuman lebih rendah."</data>
  <data key="d2">chunk-41536f4ea22764b750d1aae85eea7cf8&lt;SEP&gt;chunk-697537c22df8475923553bd58c9a2d20</data>
</node>
<node id="&quot;PENYUSUNAN BERKAS&quot;">
