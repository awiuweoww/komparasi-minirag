# ==============================================================================
# KONFIGURASI OPENAI API UNTUK PENERJEMAHAN UNCLOS 1982
# ==============================================================================

# 1. Kunci Rahasia API OpenAI (Isi dengan API Key Anda)
OPENAI_API_KEY=your_openai_api_key_here

# 2. Endpoint Base URL (Default: https://api.openai.com/v1)
# Jika menggunakan reverse proxy / Azure OpenAI / custom gateway, sesuaikan di sini:
OPENAI_BASE_URL=https://api.openai.com/v1

# 3. Model LLM yang Ditugaskan
# Sesuai instruksi: gpt-5.4
# (Jika model gpt-5.4 belum aktif di akun Anda, Anda dapat menggantinya dengan: gpt-4o atau gpt-4.5-preview)
OPENAI_MODEL=gpt-5.4

# 4. Parameter Generasi & Concurrency
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=8192
REQUEST_CONCURRENCY=4
TIMEOUT_SECONDS=180
RETRY_ATTEMPTS=5
RETRY_DELAY_SECONDS=3

# 5. Konfigurasi Path Berkas (Opsional, sudah ada default otomatis)
INPUT_MD_PATH=hasilmineru/output.md
OUTPUT_DEFAULT_DIR=indonesiaversion/default
OUTPUT_STRUKTUR_DIR=indonesiaversion/struktur_pasal

